        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef note fill:#FFD1DC,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3{Decision}:::decision\n        L4[(Data / Libraries)]:::io\n        L5[\&quot;Implementation Note\&quot;]:::note\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml::saveDocument&lt;br/&gt;External Method outside of Propulsion Design)]:::io\n        Ext2[(C++ Standard Library&lt;br/&gt;std::filesystem::exists)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Phase 5: PropulsionDesign::save()&lt;br/&gt;File: src/propulsion_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 1)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Save and Export Pipeline\&quot;]\n        direction TB\n        \n        %% Directory Check\n        CheckDir{Does engine data&lt;br/&gt;directory exist?}:::decision\n        CreateDir[\&quot;Call this-&gt;get_RuntimeIO()-&gt;createEngineDataDir()\&quot;]:::process\n        \n        %% Save XML\n        SaveXML[\&quot;Call aixml::saveDocument(...)&lt;br/&gt;Saves *this-&gt;aircraft_xml\&quot;]:::process\n        \n        %% Delegate Save (Empty implementations)\n        DelegateSave[\&quot;Call .save() on all domain designers\&quot;]:::process\n        \n        EmptyOverridesNote[\&quot;Note: The following methods are currently&lt;br/&gt;empty virtual overrides in the base class:&lt;br/&gt;&lt;br/&gt;this-&gt;engine_designer-&gt;save();&lt;br/&gt;this-&gt;nacelle_designer-&gt;save();&lt;br/&gt;this-&gt;propulsion_integrator-&gt;save();&lt;br/&gt;this-&gt;pylon_designer-&gt;save();&lt;br/&gt;this-&gt;mass_analyzer-&gt;save();\&quot;]:::note\n        \n        %% Flow Connections\n        CheckDir --&gt;|No| CreateDir\n        CheckDir --&gt;|Yes| SaveXML\n        CreateDir --&gt; SaveXML\n        \n        SaveXML --&gt; DelegateSave\n        DelegateSave -.-&gt; EmptyOverridesNote\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckDir\n    \n    EndNode([End Phase 5: PropulsionDesign::save() Complete&lt;br&gt;Module Execution Finished]):::startEnd\n    \n    DelegateSave --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CheckDir -. \&quot;Uses\&quot; .-&gt; Ext2\n    SaveXML -. \&quot;Calls\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PZ5mkzE-7WF-LZCCTjkr-1">
