        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3{Decision}:::decision\n        L4[(Data / Libraries)]:::io\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(Report / HTML utilities&lt;br/&gt;External Method outside of Propulsion Design (moduleBasics/))]:::io\n        Ext2[(C++ Standard Library&lt;br/&gt;std::filesystem, std::stringstream)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Level 2 Subroutine: PropulsionDesign::create_html_report()&lt;br/&gt;File: src/report/create_html_report.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;HTML Stream Generation\&quot;]\n        direction TB\n        \n        InitReport[\&quot;Instantiate Report object&lt;br/&gt;Get html_stream\&quot;]:::process\n        \n        CalcPath[\&quot;Calculate relative plot directory\&quot;]:::process\n        \n        InsertSummary[\&quot;Format and insert Data summary table&lt;br/&gt;(via local insert_summary helper)\&quot;]:::process\n        \n        ListEngines[\&quot;Format and insert HTML list&lt;br/&gt;of all designed engine models\&quot;]:::process\n        \n        LoopEngines{Iterate over&lt;br/&gt;all propulsions}:::decision\n        \n        InsertEngine[\&quot;Format and insert individual engine data&lt;br/&gt;(via local insert_engine helper)\&quot;]:::process\n        \n        CheckPlotOn{Is get_RuntimeIO()-&gt;plotOn&lt;br/&gt;enabled?}:::decision\n        \n        InsertPlots[\&quot;Format and insert SVG image tags for all nacelles&lt;br/&gt;(via local insert_plots helper)\&quot;]:::process\n        \n        Generate[\&quot;Finalize and write to disk:&lt;br/&gt;report.generateHtmlReport(&#39;&#39;)\&quot;]:::process\n        \n        %% Flow Connections\n        InitReport --&gt; CalcPath\n        CalcPath --&gt; InsertSummary\n        InsertSummary --&gt; ListEngines\n        ListEngines --&gt; LoopEngines\n        \n        LoopEngines --&gt;|Next Engine| InsertEngine\n        InsertEngine --&gt; LoopEngines\n        \n        LoopEngines --&gt;|Done| CheckPlotOn\n        CheckPlotOn --&gt;|Yes| InsertPlots\n        InsertPlots --&gt; Generate\n        CheckPlotOn --&gt;|No| Generate\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; InitReport\n    \n    EndNode([End create_html_report() Complete&lt;br&gt;Return control to PropulsionDesign::report()]):::startEnd\n    Generate --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    InitReport -. \&quot;Uses\&quot; .-&gt; Ext1\n    Generate -. \&quot;Uses\&quot; .-&gt; Ext1\n    CalcPath -. \&quot;Uses\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="e4uMAbwKLflNn8gwJU0E-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
