  <diagram id="EYTX0gRNSgLpzsUCd4Qt" name="this-&gt;create_plots()">
    <mxGraphModel dx="1323" dy="559" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3{Decision}:::decision\n        L4[(Data / Libraries)]:::io\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(Matplot++ / SVG Libs&lt;br/&gt;External Method outside of Propulsion Design)]:::io\n        Ext2[(C++ Standard Library&lt;br/&gt;std::filesystem, std::ranges)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Level 2 Subroutine: PropulsionDesign::create_plots()&lt;br/&gt;File: src/report/create_plots.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;SVG Plot Generation\&quot;]\n        direction TB\n        \n        GetDir[\&quot;Get plot directory path&lt;br/&gt;(get_RuntimeIO()-&gt;getPlotDir)\&quot;]:::process\n        \n        PlotBucket[\&quot;Call plot::bucket_curve(...)&lt;br/&gt;Generates TSFC vs Thrust graph\&quot;]:::process\n        \n        PlotOverview[\&quot;Call plot::top_overview(...)&lt;br/&gt;Generates full aircraft top-down view\&quot;]:::process\n        \n        LoopEngines{Iterate over&lt;br/&gt;all propulsions}:::decision\n        \n        PlotFront[\&quot;Call plot::nacelle_front(...)&lt;br/&gt;via std::visit\&quot;]:::process\n        PlotSide[\&quot;Call plot::nacelle_side(...)&lt;br/&gt;via std::visit\&quot;]:::process\n        \n        %% Flow Connections\n        GetDir --&gt; PlotBucket\n        PlotBucket --&gt; PlotOverview\n        PlotOverview --&gt; LoopEngines\n        \n        LoopEngines --&gt;|Next Engine| PlotFront\n        PlotFront --&gt; PlotSide\n        PlotSide --&gt; LoopEngines\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; GetDir\n    \n    EndNode([End create_plots() Complete&lt;br&gt;Return control to PropulsionDesign::report()]):::startEnd\n    LoopEngines --&gt;|Done| EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    PlotBucket -. \&quot;Uses\&quot; .-&gt; Ext1\n    PlotOverview -. \&quot;Uses\&quot; .-&gt; Ext1\n    PlotFront -. \&quot;Uses\&quot; .-&gt; Ext1\n    GetDir -. \&quot;Uses\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="K6m-LTFQo-WKfxXjIntA-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="K6m-LTFQo-WKfxXjIntA-2">
          <mxCell parent="K6m-LTFQo-WKfxXjIntA-1" style="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="485" width="270" x="367" y="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Entry / Exit" mermaidId="n:L1" mermaidBaseStyle="html=1;rounded=1;whiteSpace=wrap;arcSize=50;strokeWidth=2;fillColor=#C8C8FF;strokeColor=#7A7AD8;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Entry / Exit" id="K6m-LTFQo-WKfxXjIntA-3">
          <mxCell parent="K6m-LTFQo-WKfxXjIntA-2" style="html=1;rounded=1;whiteSpace=wrap;arcSize=50;strokeWidth=2;fillColor=#C8C8FF;strokeColor=#7A7AD8;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="39" width="107" x="82" y="45" as="geometry" />
          </mxCell>
