  <diagram id="UTYOihSporu_J3GxMBCI" name="this-&gt;create_xml_report()">
    <mxGraphModel dx="1890" dy="799" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3{Decision}:::decision\n        L4[(Data / Libraries)]:::io\n        L5[Exception / Error]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml Library&lt;br/&gt;External Method outside of Propulsion Design)]:::io\n        Ext2[(C++ Standard Library&lt;br/&gt;std::filesystem, std::time)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Level 2 Subroutine: PropulsionDesign::create_xml_report()&lt;br/&gt;File: src/report/create_xml_report.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;XML Report Generation\&quot;]\n        direction TB\n        \n        %% Initial Setup\n        GetTime[\&quot;Calculate current execution datetime\&quot;]:::process\n        \n        CheckDir{Does output XML&lt;br/&gt;directory exist?}:::decision\n        CreateDir[\&quot;Create directories via std::filesystem\&quot;]:::process\n        \n        CheckOldFile{Does old results&lt;br/&gt;XML exist?}:::decision\n        DeleteOldFile[\&quot;Delete old XML file\&quot;]:::process\n        \n        %% Base File Creation\n        ExtractProject[\&quot;Extract project name from configuration_xml\&quot;]:::process\n        WriteBase[\&quot;Write base &lt;module_results_file&gt; XML structure&lt;br/&gt;using std::ofstream\&quot;]:::process\n        \n        %% XML Copy Logic\n        TryBlock[\&quot;try { Extract and copy propulsion node }\&quot;]:::process\n        \n        OpenDoc[\&quot;Call aixml::openDocument(results_xml_path)\&quot;]:::process\n        FindDest[\&quot;Find &lt;calculation_results&gt; destination node\&quot;]:::process\n        FindSrc[\&quot;Find aircraft_exchange_file/.../propulsion&lt;br/&gt;source node in *this-&gt;aircraft_xml\&quot;]:::process\n        \n        CheckSrc{Is source&lt;br/&gt;propulsion node&lt;br/&gt;valid?}:::decision\n        \n        RecursiveCopy[\&quot;Execute recursive lambda copy_structure_and_end_values()&lt;br/&gt;to deep-copy XML sub-tree\&quot;]:::process\n        \n        SaveDoc[\&quot;Call aixml::saveDocument(...)\&quot;]:::process\n        CloseDoc[\&quot;Call aixml::closeDocument(...)\&quot;]:::process\n        \n        CatchBlock[\&quot;catch: Print exception\&quot;]:::error\n        \n        %% Flow Connections\n        GetTime --&gt; CheckDir\n        CheckDir --&gt;|No| CreateDir\n        CheckDir --&gt;|Yes| CheckOldFile\n        CreateDir --&gt; CheckOldFile\n        \n        CheckOldFile --&gt;|Yes| DeleteOldFile\n        CheckOldFile --&gt;|No| ExtractProject\n        DeleteOldFile --&gt; ExtractProject\n        \n        ExtractProject --&gt; WriteBase\n        WriteBase --&gt; TryBlock\n        \n        TryBlock --&gt; OpenDoc\n        OpenDoc --&gt; FindDest\n        FindDest --&gt; FindSrc\n        FindSrc --&gt; CheckSrc\n        \n        CheckSrc --&gt;|Yes| RecursiveCopy\n        CheckSrc --&gt;|No| SaveDoc\n        \n        RecursiveCopy --&gt; SaveDoc\n        SaveDoc --&gt; CloseDoc\n        \n        TryBlock --&gt;|Exception| CatchBlock\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; GetTime\n    \n    EndNode([End create_xml_report() Complete&lt;br&gt;Return control to PropulsionDesign::report()]):::startEnd\n    CloseDoc --&gt; EndNode\n    CatchBlock --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CheckDir -. \&quot;Uses\&quot; .-&gt; Ext2\n    OpenDoc -. \&quot;Calls\&quot; .-&gt; Ext1\n    SaveDoc -. \&quot;Calls\&quot; .-&gt; Ext1\n    CloseDoc -. \&quot;Calls\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8Qd540i6YPKkd2eR_9Na-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
