        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef note fill:#FFD1DC,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3{Decision}:::decision\n        L4[[Subroutine]]:::subroutine\n        L5[(Data / Dependencies)]:::io\n        L6[\&quot;Implementation Note\&quot;]:::note\n    end\n    \n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(create_xml_report.cpp&lt;br/&gt;Local File: src/report/)]:::io\n        Ext2[(create_html_report.cpp&lt;br/&gt;Local File: src/report/)]:::io\n        Ext3[(create_plots.cpp&lt;br/&gt;Local File: src/report/)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Phase 4: PropulsionDesign::report()&lt;br/&gt;File: src/propulsion_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 1)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Report Generation Pipeline\&quot;]\n        direction TB\n        \n        %% XML Check\n        CheckXML{Is get_RuntimeIO()-&gt;xmlOn&lt;br/&gt;enabled?}:::decision\n        CreateXML[[Subroutine: this-&gt;create_xml_report()&lt;br/&gt;Internal Method within Propulsion Design (src/report/)]]:::subroutine\n        \n        %% Report Check\n        CheckReport{Is get_RuntimeIO()-&gt;reportOn&lt;br/&gt;enabled?}:::decision\n        \n        %% Delegate Report (Empty implementations)\n        DelegateReport[\&quot;Call .report() on all domain designers\&quot;]:::process\n        \n        EmptyOverridesNote[\&quot;Note: The following methods are currently&lt;br/&gt;empty virtual overrides in the base class:&lt;br/&gt;&lt;br/&gt;this-&gt;engine_designer-&gt;report();&lt;br/&gt;this-&gt;nacelle_designer-&gt;report();&lt;br/&gt;this-&gt;propulsion_integrator-&gt;report();&lt;br/&gt;this-&gt;pylon_designer-&gt;report();&lt;br/&gt;this-&gt;mass_analyzer-&gt;report();\&quot;]:::note\n        \n        %% HTML Report\n        CreateHTML[[Subroutine: this-&gt;create_html_report()&lt;br/&gt;Internal Method within Propulsion Design (src/report/)]]:::subroutine\n        \n        %% Plot Check\n        CheckPlot{Is get_RuntimeIO()-&gt;plotOn&lt;br/&gt;enabled?}:::decision\n        CreatePlots[[Subroutine: this-&gt;create_plots()&lt;br/&gt;Internal Method within Propulsion Design (src/report/)]]:::subroutine\n        \n        %% Flow Connections\n        CheckXML --&gt;|Yes| CreateXML\n        CheckXML --&gt;|No| CheckReport\n        CreateXML --&gt; CheckReport\n        \n        CheckReport --&gt;|Yes| DelegateReport\n        DelegateReport -.-&gt; EmptyOverridesNote\n        DelegateReport --&gt; CreateHTML\n        \n        CreateHTML --&gt; CheckPlot\n        CheckPlot --&gt;|Yes| CreatePlots\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckXML\n    \n    EndNode([End Phase 4: PropulsionDesign::report() Complete&lt;br&gt;Return control to main loop]):::startEnd\n    \n    CheckReport --&gt;|No| EndNode\n    CheckPlot --&gt;|No| EndNode\n    CreatePlots --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CreateXML -. \&quot;Implemented in\&quot; .-&gt; Ext1\n    CreateHTML -. \&quot;Implemented in\&quot; .-&gt; Ext2\n    CreatePlots -. \&quot;Implemented in\&quot; .-&gt; Ext3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2bNqyM1eyebQ3Uzk1bH5-1">
