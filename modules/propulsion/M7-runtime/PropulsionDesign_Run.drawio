  <diagram id="vqVeQVaOlLOuf6oQxqym" name="io::load_engine_scaled()">
    <mxGraphModel dx="3340" dy="1050" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style EngineConstruction fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction LR\n        Ext1[(std::filesystem&lt;br/&gt;External library in C++ Std)]:::io\n        Ext2[(aixml::openDocument&lt;br/&gt;External Method outside of Propulsion Design (libraries/aixml/include/aixml/node.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start io::load_engine_scaled()&lt;br/&gt;File: src/io/engine_xml.h]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;XML File Search &amp; Load Scaled Engine Workflow\&quot;]\n        direction TB\n        \n        BuildPath[\&quot;Build expected folder path&lt;br/&gt;std::filesystem::path{engine_name}\&quot;]:::process\n        \n        SearchLoop{For each search_path&lt;br/&gt;in provided paths}:::decision\n        \n        BuildFull[\&quot;Build full engine_xml_path&lt;br/&gt;search_path / file_path\&quot;]:::process\n        CheckExists{Does std::filesystem::exists() return true?}:::decision\n        \n        %% SECTION BOX FOR CONSTRUCTOR LOGIC\n        subgraph EngineConstruction [\&quot;Expanded View: Engine{...} Constructor (External Method outside of Propulsion Design (libraries/engine/src/engine.cpp))\&quot;]\n            direction TB\n            ConstDelegate[\&quot;Delegate to base constructor&lt;br/&gt;Engine{engine_directory}\&quot;]:::process\n            ConstBuildXMLPath[\&quot;Construct XML path string&lt;br/&gt;directory + filename + &#39;.xml&#39;\&quot;]:::process\n            ConstParseXML[\&quot;Parse XML file via aixml&lt;br/&gt;aixml::openDocument(...)\&quot;]:::process\n            ConstInitData[\&quot;Initialize engine_data_ member\&quot;]:::process\n            ConstInitState[\&quot;Initialize Engine limits &amp; operating points&lt;br/&gt;from parsed engine_data_\&quot;]:::process\n            ConstSetScale[\&quot;Return to scaled constructor&lt;br/&gt;Set this-&gt;scale_factor_ = scale_factor\&quot;]:::process\n        end\n        \n        ThrowError[\&quot;Throw std::runtime_error&lt;br/&gt;&#39;The engine XML file could not be found!&#39;\&quot;]:::error\n        \n        %% Strict Layout Routing\n        BuildPath --&gt; SearchLoop\n        \n        SearchLoop --&gt;|Next Path| BuildFull\n        BuildFull --&gt; CheckExists\n        \n        CheckExists --&gt;|No| SearchLoop\n        CheckExists --&gt;|Yes| ConstDelegate\n        \n        %% Section Box Routing\n        ConstDelegate --&gt; ConstBuildXMLPath\n        ConstBuildXMLPath --&gt; ConstParseXML\n        ConstParseXML --&gt; ConstInitData\n        ConstInitData --&gt; ConstInitState\n        ConstInitState --&gt; ConstSetScale\n        \n        SearchLoop --&gt;|Loop Exhausted| ThrowError\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; BuildPath\n    \n    EndNode([End io::load_engine_scaled()&lt;br&gt;Return Engine object to caller]):::startEnd\n    \n    ConstSetScale --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CheckExists -. \&quot;Uses\&quot; .-&gt; Ext1\n    ConstParseXML -. \&quot;Calls external parser\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GlCxztkGcKQOqM5jjjeR-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
