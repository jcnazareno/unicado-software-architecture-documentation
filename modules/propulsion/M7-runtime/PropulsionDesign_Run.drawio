        <UserObject label="Data / Libraries" mermaidId="n:L3" mermaidBaseStyle="html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;strokeWidth=1;whiteSpace=wrap;fillColor=#FFE4C4;strokeColor=#D9B382;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Data / Libraries" id="-K8ygHnrq2lUVR-BiPJN-99">
