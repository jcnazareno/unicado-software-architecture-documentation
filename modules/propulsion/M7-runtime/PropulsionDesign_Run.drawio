  <diagram id="pA4Domm5rcAPYNEoZ6B6" name="this-&gt;integration_into_fuselage()">
    <mxGraphModel dx="20100" dy="8400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpSelectFuselage fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpUserShift fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::measure::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/measure.h))]:::io\n        Ext2[(geom2::transform::to_parent&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/transform.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::integrate_into_fuselage()&lt;br/&gt;Entry Point from Default::operator()]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Fuselage Integration Position Calculation Workflow\&quot;]\n        direction TB\n        \n        CallSelectFuselage[\&quot;Subroutine: this-&gt;select_fuselage()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        \n        CheckOrientation{Is fuselage oriented in&lt;br/&gt;X-direction?}:::decision\n        ThrowOrientationErr[\&quot;Throw runtime_error&lt;br/&gt;Fuselage orientation not applicable\&quot;]:::error\n        \n        CheckNumEngines{Is this-&gt;n_engines_.fuselage&lt;br/&gt;equal to 2?}:::decision\n        ThrowNumErr[\&quot;Throw runtime_error&lt;br/&gt;Engine count not supported\&quot;]:::error\n        \n        CheckPlaced{Is engine parent&lt;br/&gt;in this-&gt;parents_placed?}:::decision\n        ThrowPlacedErr[\&quot;Throw runtime_error&lt;br/&gt;No space left on fuselage\&quot;]:::error\n        \n        %% Geometry Measurement Block\n        MeasureFuselage[\&quot;Call: geom2::measure::length(fuselage)&lt;br/&gt;geom2::measure::height(fuselage, z)&lt;br/&gt;geom2::measure::width(fuselage, z)&lt;br/&gt;geom2::measure::width_max(engine.nacelle())\&quot;]:::process\n        \n        CalcLocalPos[\&quot;Calculate local position (x, y, z)&lt;br/&gt;based on engine variant constants\&quot;]:::process\n        \n        CreatePos[\&quot;auto position = {x, y, z}\&quot;]:::process\n        \n        CheckVariant{Is engine variant&lt;br/&gt;Openrotorfan?}:::decision\n        CallUserShift[\&quot;Subroutine: this-&gt;calculate_user_shift()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        \n        CheckLeft{Is engine Lateral::Left?}:::decision\n        NegateX[\&quot;position.x = -position.x\&quot;]:::process\n        \n        TransformToGlobal[\&quot;Call: geom2::transform::to_parent(fuselage, position)\&quot;]:::process\n        \n        SetPos[\&quot;Call: engine.set_position()\&quot;]:::process\n        IncDone[\&quot;Increment engines_done.fuselage\&quot;]:::process\n        \n        %% Flow\n        CallSelectFuselage --&gt; CheckOrientation\n        CheckOrientation --&gt;|No| ThrowOrientationErr\n        CheckOrientation --&gt;|Yes| CheckNumEngines\n        \n        CheckNumEngines --&gt;|No| ThrowNumErr\n        CheckNumEngines --&gt;|Yes| CheckPlaced\n        \n        CheckPlaced --&gt;|Yes| ThrowPlacedErr\n        CheckPlaced --&gt;|No| MeasureFuselage\n        \n        MeasureFuselage --&gt; CalcLocalPos\n        CalcLocalPos --&gt; CreatePos\n        CreatePos --&gt; CheckVariant\n        \n        CheckVariant --&gt;|Yes| CallUserShift\n        CheckVariant --&gt;|No| CheckLeft\n        \n        CallUserShift --&gt; CheckLeft\n        \n        CheckLeft --&gt;|Yes| NegateX\n        CheckLeft --&gt;|No| TransformToGlobal\n        NegateX --&gt; TransformToGlobal\n        \n        TransformToGlobal --&gt; SetPos\n        SetPos --&gt; IncDone\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n    subgraph ExpSelectFuselage [\&quot;Expanded View: this-&gt;select_fuselage()\&quot;]\n        direction TB\n        SF_CheckSize{Is fuselages.size() != 1?}:::decision\n        SF_Throw[\&quot;Throw runtime_error\&quot;]:::error\n        SF_Return[\&quot;Return first fuselage\&quot;]:::process\n        \n        SF_CheckSize --&gt;|Yes| SF_Throw\n        SF_CheckSize --&gt;|No| SF_Return\n    end\n\n    subgraph ExpUserShift [\&quot;Expanded View: this-&gt;calculate_user_shift()\&quot;]\n        direction TB\n        US_Read[\&quot;Read usershift_x, usershift_y, usershift_z&lt;br/&gt;from config\&quot;]:::process\n        US_Apply[\&quot;position.x += usershift_x&lt;br/&gt;position.y += usershift_z&lt;br/&gt;position.z -= usershift_y\&quot;]:::process\n        US_Return[\&quot;Return position\&quot;]:::process\n        \n        US_Read --&gt; US_Apply\n        US_Apply --&gt; US_Return\n    end\n\n    CallSelectFuselage -. \&quot;Expands to\&quot; .-&gt; SF_CheckSize\n    CallUserShift -. \&quot;Expands to\&quot; .-&gt; US_Read\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CallSelectFuselage\n    \n    EndNode([End Default::integrate_into_fuselage() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    IncDone --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    MeasureFuselage -. \&quot;Calls length() / height() / width() / width_max()\&quot; .-&gt; Ext1\n    TransformToGlobal -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="eDuQok-xPLVrUXd9bvVB-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
