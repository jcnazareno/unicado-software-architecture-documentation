  <diagram id="8yIposqAKBRxLCY89NlC" name="this-&gt;get_section_shape()">
    <mxGraphModel dx="1675" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::build::ellipse&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/geometry/builder.h))]:::io\n        Ext2[(geom2::io::read_dat_file&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/io/dat.h))]:::io\n        Ext3[(std::filesystem&lt;br/&gt;External C++ Library)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::get_section_shape()&lt;br/&gt;File: src/nacelle/default/default_nacelle.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Nacelle Cross-Section Shape Generation Workflow\&quot;]\n        direction TB\n        \n        ReadShape[\&quot;Read shape_name for engine_id&lt;br/&gt;from this-&gt;section_shapes map\&quot;]:::process\n        CheckShape{Is shape_name&lt;br/&gt;&#39;circle&#39; or &#39;ellipse&#39;?}:::decision\n        BuildEllipse[\&quot;Call: geom2::build::ellipse(1.0, 1.0)\&quot;]:::process\n        \n        CheckDat{Does shape_name&lt;br/&gt;end with &#39;.dat&#39;?}:::decision\n        CheckExists{Call: std::filesystem::exists()&lt;br/&gt;Does .dat file exist?}:::decision\n        \n        ReadDat[\&quot;Call: geom2::io::read_dat_file()\&quot;]:::process\n        CreateDat[\&quot;Create default &#39;nacelle.dat&#39; file\&quot;]:::process\n        \n        ThrowErr[\&quot;Throw invalid_argument&lt;br/&gt;Shape not supported\&quot;]:::error\n        Return[\&quot;Return geom2::PolygonSection\&quot;]:::process\n        \n        %% Routing\n        ReadShape --&gt; CheckShape\n        \n        CheckShape --&gt;|Yes| BuildEllipse\n        BuildEllipse --&gt; Return\n        \n        CheckShape --&gt;|No| CheckDat\n        CheckDat --&gt;|Yes| CheckExists\n        CheckDat --&gt;|No| ThrowErr\n        \n        CheckExists --&gt;|Yes| ReadDat\n        CheckExists --&gt;|No| CreateDat\n        CreateDat --&gt; ReadDat\n        ReadDat --&gt; Return\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ReadShape\n    \n    EndNode([End Default::get_section_shape() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    Return --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    BuildEllipse -. \&quot;Calls\&quot; .-&gt; Ext1\n    ReadDat -. \&quot;Calls\&quot; .-&gt; Ext2\n    CheckExists -. \&quot;Calls\&quot; .-&gt; Ext3\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zE48xoOeOfnPXigG4n3I-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
