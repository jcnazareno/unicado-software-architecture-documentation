  <diagram id="6-ve1DiSe1u0MXPCDrwK" name="this-&gt;select_engine()">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpLoadLHS fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpLoadRHS fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine Call]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction LR\n        Ext1[(std::filesystem&lt;br/&gt;External C++ Library)]:::io\n        Ext2[(aixml/node.h&lt;br/&gt;External Method outside of Propulsion Design (libraries/aixml/include/aixml/node.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Rubber::select_engine()&lt;br/&gt;Entry Point from rubber_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Engine Selection Algorithm Workflow\&quot;]\n        direction TB\n        \n        GetDB[\&quot;Call: this-&gt;engine_database()&lt;br/&gt;Retrieve database path\&quot;]:::process\n        IterateDB[\&quot;Scan directory via std::filesystem&lt;br/&gt;Filter for valid directories\&quot;]:::process\n        PopulateList[\&quot;Extract folder names and populate&lt;br/&gt;engine_names list via std::ranges::copy\&quot;]:::process\n        \n        %% Main Loop Start\n        MinElementLoop{For each pair in engine_names&lt;br/&gt;Find minimum SLST deviation}:::decision\n        \n        CallLoadLHS[\&quot;Subroutine: io::load_engine_data(lhs)&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h)\&quot;]:::subroutine\n        ExtractSLST_LHS[\&quot;Call: lhs_EngineData.SLST()\&quot;]:::process\n        \n        CallLoadRHS[\&quot;Subroutine: io::load_engine_data(rhs)&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h)\&quot;]:::subroutine\n        ExtractSLST_RHS[\&quot;Call: rhs_EngineData.SLST()\&quot;]:::process\n        \n        CompareThrust[\&quot;Compare: abs(lhs_SLST - required_thrust)&lt;br/&gt;vs abs(rhs_SLST - required_thrust)\&quot;]:::process\n\n        %% Result check\n        CheckResult{Is best_engine == end()?}:::decision\n        ThrowErrorMain[\&quot;Throw: std::runtime_error&lt;br/&gt;&#39;No engine found in the database&#39;\&quot;]:::error\n        ReturnEngine[\&quot;Return: *best_engine\&quot;]:::process\n\n        %% Strict Top-to-Bottom Flow Routing\n        GetDB --&gt; IterateDB\n        IterateDB --&gt; PopulateList\n        PopulateList --&gt; MinElementLoop\n        \n        %% Loop execution\n        MinElementLoop --&gt;|Compare next pair| CallLoadLHS\n        CallLoadLHS --&gt; ExtractSLST_LHS\n        ExtractSLST_LHS --&gt; CallLoadRHS\n        CallLoadRHS --&gt; ExtractSLST_RHS\n        ExtractSLST_RHS --&gt; CompareThrust\n        CompareThrust --&gt; MinElementLoop\n        \n        %% Exit loop\n        MinElementLoop --&gt;|Comparison Complete| CheckResult\n        \n        CheckResult --&gt;|Yes| ThrowErrorMain\n        CheckResult --&gt;|No| ReturnEngine\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n\n    %% SECTION BOX: LHS SLST EXTRACTION\n    subgraph ExpLoadLHS [\&quot;Expanded View: io::load_engine_data(lhs) (Internal Method within Propulsion Design (src/io/engine_xml.h))\&quot;]\n        direction TB\n        LHS_BuildPath[\&quot;Build expected file path&lt;br/&gt;&#39;lhs/lhs.xml&#39;\&quot;]:::process\n        LHS_SearchLoop{For each path&lt;br/&gt;in database}:::decision\n        LHS_CheckExists{Does file exist?}:::decision\n        LHS_ParseXML[\&quot;Parse XML file via aixml\&quot;]:::process\n        LHS_InitData[\&quot;Return EngineData object\&quot;]:::process\n        LHS_ThrowError[\&quot;Throw std::runtime_error&lt;br/&gt;File not found\&quot;]:::error\n        \n        LHS_BuildPath --&gt; LHS_SearchLoop\n        LHS_SearchLoop --&gt;|Next Path| LHS_CheckExists\n        LHS_CheckExists --&gt;|No| LHS_SearchLoop\n        LHS_CheckExists --&gt;|Yes| LHS_ParseXML\n        LHS_ParseXML --&gt; LHS_InitData\n        LHS_SearchLoop --&gt;|Loop Exhausted| LHS_ThrowError\n    end\n    \n    CallLoadLHS -. \&quot;Expands to\&quot; .-&gt; LHS_BuildPath\n    \n    %% SECTION BOX: RHS SLST EXTRACTION\n    subgraph ExpLoadRHS [\&quot;Expanded View: io::load_engine_data(rhs) (Internal Method within Propulsion Design (src/io/engine_xml.h))\&quot;]\n        direction TB\n        RHS_BuildPath[\&quot;Build expected file path&lt;br/&gt;&#39;rhs/rhs.xml&#39;\&quot;]:::process\n        RHS_SearchLoop{For each path&lt;br/&gt;in database}:::decision\n        RHS_CheckExists{Does file exist?}:::decision\n        RHS_ParseXML[\&quot;Parse XML file via aixml\&quot;]:::process\n        RHS_InitData[\&quot;Return EngineData object\&quot;]:::process\n        RHS_ThrowError[\&quot;Throw std::runtime_error&lt;br/&gt;File not found\&quot;]:::error\n        \n        RHS_BuildPath --&gt; RHS_SearchLoop\n        RHS_SearchLoop --&gt;|Next Path| RHS_CheckExists\n        RHS_CheckExists --&gt;|No| RHS_SearchLoop\n        RHS_CheckExists --&gt;|Yes| RHS_ParseXML\n        RHS_ParseXML --&gt; RHS_InitData\n        RHS_SearchLoop --&gt;|Loop Exhausted| RHS_ThrowError\n    end\n\n    CallLoadRHS -. \&quot;Expands to\&quot; .-&gt; RHS_BuildPath\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; GetDB\n    \n    EndNode([End Rubber::select_engine Complete&lt;br&gt;Return control to Rubber::operator()]):::startEnd\n    ReturnEngine --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    IterateDB -. \&quot;Uses\&quot; .-&gt; Ext1\n    LHS_ParseXML -. \&quot;Calls external parser\&quot; .-&gt; Ext2\n    RHS_ParseXML -. \&quot;Calls external parser\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QgM3tKLhEpDpj6w4WXBN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
