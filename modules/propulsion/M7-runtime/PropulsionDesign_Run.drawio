  <diagram id="rOnHRH4RNezCEdAialVy" name="engine_designer-&gt;operator()">
    <mxGraphModel dx="3097" dy="510" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(io::load_engine_data&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h))]:::io\n        Ext2[(io::load_engine_scaled&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h))]:::io\n        Ext3[(Engine Core&lt;br/&gt;External Method outside of Propulsion Design (libraries/engine/src/))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Rubber::operator()&lt;br/&gt;Entry Point from std::visit in PropulsionDesign::run()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Engine Sizing Unified Workflow (Rubber Strategy)\&quot;]\n        direction TB\n        \n        CheckPreselect[\&quot;Call: this-&gt;preselected_engine(engine.id())\&quot;]:::process\n        \n        DecidePreselect{Is model_preselected.has_value()?}:::decision\n        \n        SetPreselected[\&quot;Call: engine.set_model(*model_preselected)\&quot;]:::process\n        CallSelectEngine[\&quot;Subroutine: this-&gt;select_engine()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        SetSelected[\&quot;Call: engine.set_model(selected_engine)\&quot;]:::process\n\n        CallLoadData[\&quot;Subroutine: io::load_engine_data()&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h)\&quot;]:::subroutine\n        \n        %% LH2 Specific Branch\n        CheckEnergyCarrier{Which operator overload&lt;br/&gt;is executing?}:::decision\n        CheckType{Is engine_data.type() != &#39;turbofan&#39;?}:::decision\n        LogError[\&quot;Call: utility::print()&lt;br/&gt;Print &#39;The engine chosen... is not correct type&#39;\&quot;]:::error\n        \n        CallLoadScaled[\&quot;Subroutine: io::load_engine_scaled()&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h)\&quot;]:::subroutine\n        \n        CallCalcPenalties[\&quot;Subroutine: engine_unscaled.calculate_N1_with_penalties()&lt;br/&gt;External Method outside of Propulsion Design (libraries/engine/src/engine.cpp)\&quot;]:::subroutine\n        \n        ScaleEngine[\&quot;Calculate scale factor&lt;br/&gt;engine.set_scale(req_thrust / unscaled_thrust)\&quot;]:::process\n        \n        ScaleDimensions[\&quot;Scale Dimensions via Raymer&lt;br/&gt;engine.set_dimension() &amp; engine.set_fan()\&quot;]:::process\n        \n        ScaleMass[\&quot;Scale Mass via Raymer + tech factor&lt;br/&gt;engine.set_pointmass()\&quot;]:::process\n        \n        CallCalcBucket[\&quot;Subroutine: this-&gt;calculate_bucket_point(engine)&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        SetBucket[\&quot;Call: engine.set_bucket_point()\&quot;]:::process\n        \n        AddEngine[\&quot;Call: this-&gt;add_designed_engine()\&quot;]:::process\n        LogOutput[\&quot;Call: utility::print()\&quot;]:::process\n\n        %% Flow\n        CheckPreselect --&gt; DecidePreselect\n        \n        DecidePreselect --&gt;|Yes| SetPreselected\n        DecidePreselect --&gt;|No| CallSelectEngine\n        CallSelectEngine --&gt; SetSelected\n        \n        SetPreselected --&gt; CallLoadData\n        SetSelected --&gt; CallLoadData\n        \n        %% Overload specific branching\n        CallLoadData --&gt; CheckEnergyCarrier\n        \n        CheckEnergyCarrier --&gt;|Turbofan LH2| CheckType\n        CheckType --&gt;|Yes| LogError\n        LogError --&gt; CallLoadScaled\n        CheckType --&gt;|No| CallLoadScaled\n        \n        CheckEnergyCarrier --&gt;|Turbofan Kerosene /&lt;br/&gt;Openrotorfan| CallLoadScaled\n        \n        %% Re-unified flow\n        CallLoadScaled --&gt; CallCalcPenalties\n        CallCalcPenalties --&gt; ScaleEngine\n        ScaleEngine --&gt; ScaleDimensions\n        ScaleDimensions --&gt; ScaleMass\n        ScaleMass --&gt; CallCalcBucket\n        CallCalcBucket --&gt; SetBucket\n        SetBucket --&gt; AddEngine\n        AddEngine --&gt; LogOutput\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckPreselect\n    \n    EndNode([End Rubber::operator() Complete&lt;br&gt;Return control to PropulsionDesign::run()]):::startEnd\n    LogOutput --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CallLoadData -. \&quot;Calls external parser\&quot; .-&gt; Ext1\n    CallLoadScaled -. \&quot;Calls external parser\&quot; .-&gt; Ext2\n    CallCalcPenalties -. \&quot;Calls engine base class\&quot; .-&gt; Ext3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Wm41MNBdEc-iFoWQBbD-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
