  <diagram id="vpY53DTqnyEAwiOOi3sj" name="this-&gt;propulsion_integrator">
    <mxGraphModel dx="3350" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(None required at this Level)]:::legendNode\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::operator()&lt;br/&gt;File: src/integration/default/default_integration.h]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Default Propulsion Integration Workflow\&quot;]\n        direction TB\n        \n        CheckVariant{Determine Engine Variant}:::decision\n        \n        %% Turbofan Route\n        TurbofanRoute[\&quot;Call: turbofan_method()&lt;br/&gt;(File: src/integration/default/turbofan.cpp)\&quot;]:::process\n        \n        %% Openrotor Route\n        OpenrotorRoute[\&quot;Call: openrotor_method()&lt;br/&gt;(File: src/integration/default/openrotorfan.cpp)\&quot;]:::process\n        \n        %% Shared Integration Logic\n        CheckSupport{Is engine.parent_component()&lt;br/&gt;in detail::supported_parents?}:::decision\n        ThrowSupportErr[\&quot;Throw runtime_error&lt;br/&gt;Parent component not supported\&quot;]:::error\n        \n        CheckAircraft{Does this-&gt;aircraft()&lt;br/&gt;exist?}:::decision\n        \n        SwitchParent{Switch on&lt;br/&gt;Parent type}:::decision\n        \n        CallWing[\&quot;Subroutine: this-&gt;integrate_into_wing()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallFuselage[\&quot;Subroutine: this-&gt;integrate_into_fuselage()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallEmpennage[\&quot;Subroutine: this-&gt;integrate_into_empennage()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallWingBody[\&quot;Subroutine: this-&gt;integrate_into_wing_body()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        ThrowParentErr[\&quot;Throw runtime_error&lt;br/&gt;Parent type not supported\&quot;]:::error\n        \n        CallGuess[\&quot;Subroutine: this-&gt;guess_position()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        \n        InsertPlaced[\&quot;Insert into this-&gt;parents_placed\&quot;]:::process\n        \n        %% Flow\n        CheckVariant --&gt;|Turbofan&lt;Kerosene/LH2&gt;| TurbofanRoute\n        CheckVariant --&gt;|Openrotorfan&lt;Kerosene&gt;| OpenrotorRoute\n        \n        TurbofanRoute --&gt; CheckSupport\n        OpenrotorRoute --&gt; CheckSupport\n        \n        CheckSupport --&gt;|No| ThrowSupportErr\n        CheckSupport --&gt;|Yes| CheckAircraft\n        \n        CheckAircraft --&gt;|Yes| SwitchParent\n        CheckAircraft --&gt;|No| CallGuess\n        \n        SwitchParent --&gt;|Parent::Wing| CallWing\n        SwitchParent --&gt;|Parent::Fuselage| CallFuselage\n        SwitchParent --&gt;|Parent::Empennage| CallEmpennage\n        SwitchParent --&gt;|Parent::WingBody| CallWingBody\n        SwitchParent --&gt;|default| ThrowParentErr\n        \n        CallWing --&gt; InsertPlaced\n        CallFuselage --&gt; InsertPlaced\n        CallEmpennage --&gt; InsertPlaced\n        CallWingBody --&gt; InsertPlaced\n        CallGuess --&gt; InsertPlaced\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckVariant\n    \n    EndNode([End Default::operator() Complete&lt;br&gt;Return control to PropulsionDesign::run()]):::startEnd\n    InsertPlaced --&gt; EndNode&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nZZf3rTw16WzRdIJFEYm-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="nZZf3rTw16WzRdIJFEYm-53">
