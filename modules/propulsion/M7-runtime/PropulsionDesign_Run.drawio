        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(std::visit&lt;br/&gt;External library in C++ Std)]:::io\n        Int1[(engine_designer&lt;br/&gt;Internal Method within Propulsion Design (src/engine_design/))]:::io\n        Int2[(nacelle_designer&lt;br/&gt;Internal Method within Propulsion Design (src/nacelle/))]:::io\n        Int3[(propulsion_integrator&lt;br/&gt;Internal Method within Propulsion Design (src/integration/))]:::io\n        Int4[(pylon_designer&lt;br/&gt;Internal Method within Propulsion Design (src/pylon/))]:::io\n        Int5[(mass_analyzer&lt;br/&gt;Internal Method within Propulsion Design (src/mass/))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start PropulsionDesign::run()&lt;br/&gt;Entry Point from main framework]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;PropulsionDesign::run() Workflow\&quot;]\n        direction TB\n        \n        LogStart[\&quot;Call: utility::print&lt;br/&gt;Print &#39;Running the design domain strategies.&#39;\&quot;]:::process\n        \n        LoopEngine{For each engine&lt;br/&gt;in this-&gt;engines?}:::decision\n        \n        LogSizingEngine[\&quot;Call: utility::print&lt;br/&gt;Print &#39;Sizing the engine...&#39;\&quot;]:::process\n        CallEngineDesigner[\&quot;Subroutine: std::visit(*this-&gt;engine_designer, engine)&lt;br/&gt;Internal Method within Propulsion Design (src/engine_design/)\&quot;]:::subroutine\n        \n        LogSizingNacelle[\&quot;Call: utility::print&lt;br/&gt;Print &#39;Sizing the nacelle...&#39;\&quot;]:::process\n        CallNacelleDesigner[\&quot;Subroutine: std::visit(*this-&gt;nacelle_designer, engine)&lt;br/&gt;Internal Method within Propulsion Design (src/nacelle_design/)\&quot;]:::subroutine\n        \n        LogPlacingEngine[\&quot;Call: utility::print&lt;br/&gt;Print &#39;Placing the engine...&#39;\&quot;]:::process\n        CallPropIntegrator[\&quot;Subroutine: std::visit(*this-&gt;propulsion_integrator, engine)&lt;br/&gt;Internal Method within Propulsion Design (src/propulsion_integration/)\&quot;]:::subroutine\n        \n        LogSizingPylon[\&quot;Call: utility::print&lt;br/&gt;Print &#39;Sizing the pylon...&#39;\&quot;]:::process\n        CallPylonDesigner[\&quot;Subroutine: std::visit(*this-&gt;pylon_designer, engine)&lt;br/&gt;Internal Method within Propulsion Design (src/pylon_design/)\&quot;]:::subroutine\n        \n        LogMassAnalyzer[\&quot;Call: utility::print&lt;br/&gt;Print &#39;Analyzing the engine mass...&#39;\&quot;]:::process\n        CallMassAnalyzer[\&quot;Subroutine: std::visit(*this-&gt;mass_analyzer, engine)&lt;br/&gt;Internal Method within Propulsion Design (src/mass_analysis/)\&quot;]:::subroutine\n        \n        CallCheckValidity[\&quot;Subroutine: this-&gt;check_validity()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n\n        %% Flow\n        LogStart --&gt; LoopEngine\n        \n        LoopEngine --&gt;|Next Engine| LogSizingEngine\n        LogSizingEngine --&gt; CallEngineDesigner\n        CallEngineDesigner --&gt; LogSizingNacelle\n        LogSizingNacelle --&gt; CallNacelleDesigner\n        CallNacelleDesigner --&gt; LogPlacingEngine\n        LogPlacingEngine --&gt; CallPropIntegrator\n        CallPropIntegrator --&gt; LogSizingPylon\n        LogSizingPylon --&gt; CallPylonDesigner\n        CallPylonDesigner --&gt; LogMassAnalyzer\n        LogMassAnalyzer --&gt; CallMassAnalyzer\n        \n        CallMassAnalyzer --&gt; LoopEngine\n        \n        LoopEngine --&gt;|No more engines| CallCheckValidity\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; LogStart\n    \n    EndNode([End PropulsionDesign::run Complete]):::startEnd\n    CallCheckValidity --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CallEngineDesigner -. \&quot;Calls operator() in\&quot; .-&gt; Int1\n    CallNacelleDesigner -. \&quot;Calls operator() in\&quot; .-&gt; Int2\n    CallPropIntegrator -. \&quot;Calls operator() in\&quot; .-&gt; Int3\n    CallPylonDesigner -. \&quot;Calls operator() in\&quot; .-&gt; Int4\n    CallMassAnalyzer -. \&quot;Calls operator() in\&quot; .-&gt; Int5&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="L3z1FDWmqAlz1rdFcpCi-1">
