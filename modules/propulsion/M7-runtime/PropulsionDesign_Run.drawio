        <UserObject label="Decision" mermaidId="n:L4" mermaidBaseStyle="rhombus;html=1;strokeWidth=1.5;whiteSpace=wrap;fillColor=#FFFACD;strokeColor=#D4C873;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Decision" id="-K8ygHnrq2lUVR-BiPJN-100">
          <mxCell parent="-K8ygHnrq2lUVR-BiPJN-96" style="rhombus;html=1;strokeWidth=1.5;whiteSpace=wrap;fillColor=#FFFACD;strokeColor=#D4C873;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
