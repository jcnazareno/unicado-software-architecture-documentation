  <diagram id="QIRk0Bj2A1zf02fVp4O0" name="this-&gt;integrate_to_empannage()">
    <mxGraphModel dx="4020" dy="1680" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpSelectFuselage fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpSelectVerticalTail fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::measure::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/measure.h))]:::io\n        Ext2[(geom2::transform::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/transform.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::integrate_into_empennage()&lt;br/&gt;Entry Point from Default::operator()]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Empennage Integration Position Calculation Workflow\&quot;]\n        direction TB\n        \n        CallSelectVerticalTail[\&quot;Subroutine: this-&gt;select_vertical_tail()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        CallSelectFuselage[\&quot;Subroutine: this-&gt;select_fuselage()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        \n        CheckPlaced{Is engine parent&lt;br/&gt;in this-&gt;parents_placed?}:::decision\n        ThrowPlacedErr[\&quot;Throw runtime_error&lt;br/&gt;No space left on empennage\&quot;]:::error\n        \n        CheckAlignment{Is empennage in line&lt;br/&gt;with fuselage center?}:::decision\n        ThrowAlignErr[\&quot;Throw runtime_error&lt;br/&gt;Empennage not in line\&quot;]:::error\n        \n        %% Geometry Measurement &amp; Transform Block\n        MeasureMAC[\&quot;Call: geom2::measure::mean_aerodynamic_chord_position(empennage)&lt;br/&gt;Returns p_25_local\&quot;]:::process\n        \n        TransformToGlobal[\&quot;Call: geom2::transform::to_parent(empennage, p_25_local)&lt;br/&gt;Returns p_25_global\&quot;]:::process\n        \n        TransformToFuselage[\&quot;Call: geom2::transform::to_local(fuselage, p_25_global)&lt;br/&gt;Returns p_25_fuselage\&quot;]:::process\n        \n        MeasureFuselageHeight[\&quot;Call: geom2::measure::height(fuselage, p_25_fuselage.z)\&quot;]:::process\n        \n        CalcLocalPos[\&quot;Calculate final position (x, y, z)&lt;br/&gt;based on MAC position and fuselage height\&quot;]:::process\n        \n        SetPos[\&quot;Call: engine.set_position(position)\&quot;]:::process\n        IncDone[\&quot;Increment engines_done.empennage\&quot;]:::process\n        \n        %% Flow\n        CallSelectVerticalTail --&gt; CallSelectFuselage\n        CallSelectFuselage --&gt; CheckPlaced\n        \n        CheckPlaced --&gt;|Yes| ThrowPlacedErr\n        CheckPlaced --&gt;|No| CheckAlignment\n        \n        CheckAlignment --&gt;|No| ThrowAlignErr\n        CheckAlignment --&gt;|Yes| MeasureMAC\n        \n        MeasureMAC --&gt; TransformToGlobal\n        TransformToGlobal --&gt; TransformToFuselage\n        TransformToFuselage --&gt; MeasureFuselageHeight\n        \n        MeasureFuselageHeight --&gt; CalcLocalPos\n        CalcLocalPos --&gt; SetPos\n        SetPos --&gt; IncDone\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n    subgraph ExpSelectFuselage [\&quot;Expanded View: this-&gt;select_fuselage()\&quot;]\n        direction TB\n        SF_CheckSize{Is fuselages.size() != 1?}:::decision\n        SF_Throw[\&quot;Throw runtime_error\&quot;]:::error\n        SF_Return[\&quot;Return first fuselage\&quot;]:::process\n        \n        SF_CheckSize --&gt;|Yes| SF_Throw\n        SF_CheckSize --&gt;|No| SF_Return\n    end\n\n    subgraph ExpSelectVerticalTail [\&quot;Expanded View: this-&gt;select_vertical_tail()\&quot;]\n        direction TB\n        SVT_FindIf[\&quot;Call: std::ranges::find_if&lt;br/&gt;(empennage, geometry::is_vertical)\&quot;]:::process\n        SVT_CheckFound{Is empennage&lt;br/&gt;found?}:::decision\n        SVT_Throw[\&quot;Throw runtime_error&lt;br/&gt;No vertical tail found\&quot;]:::error\n        SVT_Return[\&quot;Return empennage surface\&quot;]:::process\n        \n        SVT_FindIf --&gt; SVT_CheckFound\n        SVT_CheckFound --&gt;|No| SVT_Throw\n        SVT_CheckFound --&gt;|Yes| SVT_Return\n    end\n\n    CallSelectFuselage -. \&quot;Expands to\&quot; .-&gt; SF_CheckSize\n    CallSelectVerticalTail -. \&quot;Expands to\&quot; .-&gt; SVT_FindIf\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CallSelectVerticalTail\n    \n    EndNode([End Default::integrate_into_empennage() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    IncDone --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    MeasureMAC -. \&quot;Calls MAC position()\&quot; .-&gt; Ext1\n    MeasureFuselageHeight -. \&quot;Calls height()\&quot; .-&gt; Ext1\n    TransformToGlobal -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2\n    TransformToFuselage -. \&quot;Calls to_local()\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EDympLCfMRC-LoEWCDW3-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
