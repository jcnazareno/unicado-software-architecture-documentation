  <diagram id="J2hN32pUmwupp5ZPuFvB" name="this-&gt;calculate_bucket_point()">
    <mxGraphModel dx="5871" dy="2216" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction LR\n        Ext1[(io::load_engine_scaled&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h))]:::io\n        Ext2[(Engine::calculate_N1_with_penalties&lt;br/&gt;External Method outside of Propulsion Design (libraries/engine/src/engine.cpp))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Rubber::calculate_bucket_point()&lt;br/&gt;Entry Point from rubber_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Bucket Point N1 Iteration Algorithm Workflow\&quot;]\n        direction TB\n        \n        LoadEngine[\&quot;Subroutine: io::load_engine_scaled()&lt;br/&gt;Internal Method within Propulsion Design (src/io/engine_xml.h)\&quot;]:::subroutine\n        \n        %% Try/Catch block for Idle N1\n        TryIdleN1[\&quot;Subroutine: calculate_N1_with_penalties(&#39;idle&#39;)&lt;br/&gt;External Method outside of Propulsion Design (libraries/engine/src/engine.cpp)\&quot;]:::subroutine\n        CheckIdleSuccess{Did idle calculation&lt;br/&gt;throw exception?}:::decision\n        \n        LogIdleError[\&quot;Call: utility::print()&lt;br/&gt;Warning: N1 calculation failed\&quot;]:::error\n        ReturnZero[\&quot;Return BucketPoint: {0.0, 0.0}\&quot;]:::process\n        \n        SetN1Min[\&quot;Set N1_min = engine_scaled.N\&quot;]:::process\n        \n        %% Takeoff N1\n        CalcTakeoffN1[\&quot;Subroutine: calculate_N1_with_penalties(&#39;takeoff&#39;)&lt;br/&gt;External Method outside of Propulsion Design (libraries/engine/src/engine.cpp)\&quot;]:::subroutine\n        SetN1Max[\&quot;Set N1_max = engine_scaled.N\&quot;]:::process\n        \n        %% Initialization\n        SetInitOP[\&quot;Initialize OP to N1_min&lt;br/&gt;engine_scaled.set_operating_point()\&quot;]:::process\n        InitVars[\&quot;Initialize N1_previous = N1_min&lt;br/&gt;tsfc_previous = fuelflow / thrust\&quot;]:::process\n        \n        %% Bucket Iteration Loop\n        IterateBucket{For i = 0 to maxiter&lt;br/&gt;Iterate N1 to find TSFC min}:::decision\n        \n        UpdateN1[\&quot;N1 = N1_previous + step_size&lt;br/&gt;Set new OP\&quot;]:::process\n        CalcTSFC[\&quot;Calculate tsfc = fuelflow / thrust\&quot;]:::process\n        CheckGradient{Is tsfc &gt; tsfc_previous?&lt;br/&gt;(Gradient became positive?)}:::decision\n        \n        UpdateVars[\&quot;Update: tsfc_previous = tsfc&lt;br/&gt;N1_previous = N1\&quot;]:::process\n        CheckMaxN1{Is N1 &gt; N1_max?}:::decision\n        LogMaxWarning[\&quot;Call: utility::print()&lt;br/&gt;Warning: Max N1 reached\&quot;]:::error\n        \n        CheckMaxIter{Is i == maxiter - 1?}:::decision\n        LogIterWarning[\&quot;Call: utility::print()&lt;br/&gt;Warning: Max iterations reached\&quot;]:::error\n        \n        %% Finalization\n        FinalizeOP[\&quot;Set final OP = N1_previous&lt;br/&gt;Calculate final thrust &amp; fuelflow\&quot;]:::process\n        ReturnBucket[\&quot;Return BucketPoint: {thrust_bucket, tsfc_bucket}\&quot;]:::process\n        \n        %% Pipeline Flow Routing\n        LoadEngine --&gt; TryIdleN1\n        TryIdleN1 --&gt; CheckIdleSuccess\n        \n        CheckIdleSuccess --&gt;|Yes| LogIdleError\n        LogIdleError --&gt; ReturnZero\n        \n        CheckIdleSuccess --&gt;|No| SetN1Min\n        SetN1Min --&gt; CalcTakeoffN1\n        CalcTakeoffN1 --&gt; SetN1Max\n        SetN1Max --&gt; SetInitOP\n        SetInitOP --&gt; InitVars\n        InitVars --&gt; IterateBucket\n        \n        %% Loop Body\n        IterateBucket --&gt;|Next Iteration| UpdateN1\n        UpdateN1 --&gt; CalcTSFC\n        CalcTSFC --&gt; CheckGradient\n        \n        %% Gradient check\n        CheckGradient --&gt;|No| UpdateVars\n        UpdateVars --&gt; CheckMaxN1\n        CheckMaxN1 --&gt;|No| CheckMaxIter\n        CheckMaxIter --&gt;|No| IterateBucket\n        \n        CheckMaxN1 --&gt;|Yes| LogMaxWarning\n        CheckMaxIter --&gt;|Yes| LogIterWarning\n        LogIterWarning --&gt; IterateBucket\n        \n        %% Break conditions\n        CheckGradient --&gt;|Yes (Minimum Found)| FinalizeOP\n        LogMaxWarning --&gt;|Break loop| FinalizeOP\n        IterateBucket --&gt;|Loop Exhausted| FinalizeOP\n        \n        FinalizeOP --&gt; ReturnBucket\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; LoadEngine\n    \n    EndNode([End Rubber::calculate_bucket_point Complete&lt;br&gt;Return control to Rubber::operator()]):::startEnd\n    ReturnZero --&gt; EndNode\n    ReturnBucket --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    LoadEngine -. \&quot;Calls\&quot; .-&gt; Ext1\n    TryIdleN1 -. \&quot;Calls\&quot; .-&gt; Ext2\n    CalcTakeoffN1 -. \&quot;Calls\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBTHprpmsfNYHNCeEk2l-1">
