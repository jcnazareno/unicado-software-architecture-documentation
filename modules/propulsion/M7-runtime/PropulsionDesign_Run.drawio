    <mxGraphModel dx="2010" dy="840" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::measure::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/measure.h))]:::io\n        Ext2[(geom2::transform::to_parent&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/transform.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::operator()&lt;br/&gt;File: src/mass/default/default_mass.h]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Default Mass Analyzer Workflow\&quot;]\n        direction TB\n        \n        CheckVariant{Determine Engine Variant}:::decision\n        \n        %% Routes\n        TurbofanRoute[\&quot;Call: turbofan_method()&lt;br/&gt;(File: src/mass/default/turbofan.cpp)\&quot;]:::process\n        OpenrotorRoute[\&quot;Call: openrotorfan_method()&lt;br/&gt;(File: src/mass/default/openrotorfan.cpp)\&quot;]:::process\n        \n        GetThrust[\&quot;thrust = engine.required_thrust()\&quot;]:::process\n        GetDim[\&quot;dimension_engine = engine.dimension()\&quot;]:::process\n        \n        %% --- ENGINE BLOCK ---\n        CalcEngineCG[\&quot;Call: calculate_engine_CG()\&quot;]:::process\n        CheckEngineMass{Is pointmass == 0.0?}:::decision\n        CalcEngineMass[\&quot;Call: calculate_engine_mass()&lt;br/&gt;using tf_engine and thrust\&quot;]:::process\n        CalcEngineInertia[\&quot;Call: calculate_engine_inertia()\&quot;]:::process\n        SetEngineMass[\&quot;Call: engine.set_pointmass(Component::Engine)\&quot;]:::process\n        \n        %% --- NACELLE BLOCK ---\n        CalcNacelleMass[\&quot;Call: calculate_nacelle_mass()&lt;br/&gt;using tf_nacelle and thrust\&quot;]:::process\n        CalcNacelleCG[\&quot;Call: calculate_nacelle_CG()\&quot;]:::process\n        CalcNacelleInertia[\&quot;Call: calculate_nacelle_inertia()\&quot;]:::process\n        SetNacelleMass[\&quot;Call: engine.set_pointmass(Component::Nacelle)\&quot;]:::process\n        \n        %% --- PYLON BLOCK ---\n        CheckPylon{Is pylon geometry&lt;br/&gt;not empty?}:::decision\n        CalcPylonMass[\&quot;Call: calculate_pylon_mass()&lt;br/&gt;using tf_pylon and thrust\&quot;]:::process\n        CalcPylonCG[\&quot;Call: calculate_pylon_CG()\&quot;]:::process\n        CalcPylonInertia[\&quot;Call: calculate_pylon_inertia()\&quot;]:::process\n        SetPylonMass[\&quot;Call: engine.set_pointmass(Component::Pylon)\&quot;]:::process\n        \n        %% Flow Connections\n        CheckVariant --&gt;|Turbofan&lt;Kerosene/LH2&gt;| TurbofanRoute\n        CheckVariant --&gt;|Openrotorfan&lt;Kerosene&gt;| OpenrotorRoute\n        \n        TurbofanRoute --&gt; GetThrust\n        OpenrotorRoute --&gt; GetThrust\n        \n        GetThrust --&gt; GetDim\n        GetDim --&gt; CalcEngineCG\n        CalcEngineCG --&gt; CheckEngineMass\n        \n        CheckEngineMass --&gt;|Yes| CalcEngineMass\n        CheckEngineMass --&gt;|No| CalcEngineInertia\n        CalcEngineMass --&gt; CalcEngineInertia\n        CalcEngineInertia --&gt; SetEngineMass\n        \n        SetEngineMass --&gt; CalcNacelleMass\n        CalcNacelleMass --&gt; CalcNacelleCG\n        CalcNacelleCG --&gt; CalcNacelleInertia\n        CalcNacelleInertia --&gt; SetNacelleMass\n        \n        SetNacelleMass --&gt; CheckPylon\n        CheckPylon --&gt;|Yes| CalcPylonMass\n        CalcPylonMass --&gt; CalcPylonCG\n        CalcPylonCG --&gt; CalcPylonInertia\n        CalcPylonInertia --&gt; SetPylonMass\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckVariant\n    \n    EndNode([End Default::operator() Complete&lt;br&gt;Return control to PropulsionDesign::run()]):::startEnd\n    CheckPylon --&gt;|No| EndNode\n    SetPylonMass --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CalcNacelleCG -. \&quot;Calls centroid()\&quot; .-&gt; Ext1\n    CalcNacelleCG -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2\n    CalcNacelleInertia -. \&quot;Calls inertia()\&quot; .-&gt; Ext1\n    \n    CalcPylonCG -. \&quot;Calls centroid()\&quot; .-&gt; Ext1\n    CalcPylonCG -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2\n    CalcPylonInertia -. \&quot;Calls inertia()\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_2DcbAwtI1RTrT-k8ls6-1">
