      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext3[(geom2::MultisectionSurface / SectionBuilder&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::operator()&lt;br/&gt;File: src/nacelle/default/default_nacelle.h]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Default Nacelle Geometry Construction\&quot;]\n        direction TB\n        \n        CheckVariant{Determine Engine Variant}:::decision\n        \n        %% Turbofan Route\n        TurbofanRoute[\&quot;Call: turbofan_method()&lt;br/&gt;(File: src/nacelle/default/turbofan.cpp)\&quot;]:::process\n        \n        %% Openrotor Route\n        OpenrotorRoute[\&quot;Call: openrotor_method()&lt;br/&gt;(File: src/nacelle/default/openrotorfan.cpp)\&quot;]:::process\n        \n        %% Shared Core Logic Representation\n        InitBuilder[\&quot;Initialize MultisectionSurface &amp; SectionBuilder\&quot;]:::process\n        GetDiam[\&quot;Calculate max inner diameter&lt;br/&gt;max(width, height, fan_diameter)\&quot;]:::process\n        \n        CallGetShape[\&quot;Subroutine: this-&gt;get_section_shape()&lt;br/&gt;Internal Method within File (src/nacelle/default/default_nacelle.cpp)\&quot;]:::subroutine\n        \n        SetScale[\&quot;Set shape dimensions to max inner diameter\&quot;]:::process\n        BuildSections[\&quot;Insert scaled sections at absolute Z positions&lt;br/&gt;using SectionBuilder::insert_back()\&quot;]:::process\n        SetSurface[\&quot;Set assembled surface&lt;br/&gt;engine.set_nacelle(surface)&lt;br/&gt;engine.set_enginegeometry(surface_engine)\&quot;]:::process\n        \n        %% Flow\n        CheckVariant --&gt;|Turbofan&lt;Kerosene/LH2&gt;| TurbofanRoute\n        CheckVariant --&gt;|Openrotorfan&lt;Kerosene&gt;| OpenrotorRoute\n        \n        TurbofanRoute --&gt; InitBuilder\n        OpenrotorRoute --&gt; InitBuilder\n        \n        InitBuilder --&gt; GetDiam\n        GetDiam --&gt; CallGetShape\n        CallGetShape --&gt; SetScale\n        SetScale --&gt; BuildSections\n        BuildSections --&gt; SetSurface\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckVariant\n    \n    EndNode([End Default::operator() Complete&lt;br&gt;Return control to PropulsionDesign::run()]):::startEnd\n    SetSurface --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    InitBuilder -. \&quot;Instantiates\&quot; .-&gt; Ext3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="73Zj7Nq_Wo_OEvjdr2F1-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
