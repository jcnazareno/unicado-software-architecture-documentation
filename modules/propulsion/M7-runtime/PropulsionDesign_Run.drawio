  <diagram id="HawBlXM4hJ9oqdFfAhcD" name="this-&gt;pylon_designer">
    <mxGraphModel dx="1436" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::measure::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/measure.h))]:::io\n        Ext2[(geom2::transform::to_local&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/transform.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::operator()&lt;br/&gt;File: src/pylon/default/default_pylon.h]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Default Pylon Designer Workflow\&quot;]\n        direction TB\n        \n        CheckVariant{Determine Engine Variant}:::decision\n        \n        %% Routes\n        TurbofanRoute[\&quot;Call: turbofan_method()&lt;br/&gt;(File: src/pylon/default/turbofan.cpp)\&quot;]:::process\n        OpenrotorRoute[\&quot;Call: openrotorfan_method()&lt;br/&gt;(File: src/pylon/default/openrotorfan.cpp)\&quot;]:::process\n        \n        CheckApplicability{Is Vertical::In&lt;br/&gt;or no aircraft?}:::decision\n        ReturnEarly[\&quot;Return early (No pylon designed)\&quot;]:::process\n        \n        CallGetAttachment[\&quot;Subroutine: this-&gt;get_attachment_points()&lt;br/&gt;Internal Method within Propulsion Design (src/pylon/default/)\&quot;]:::subroutine\n        CallGetProfile[\&quot;Subroutine: this-&gt;get_section_profile()&lt;br/&gt;Internal Method within Propulsion Design (src/pylon/default/)\&quot;]:::subroutine\n        \n        InitPylon[\&quot;Initialize geometry::Pylon&lt;br/&gt;Set origin, normal, name\&quot;]:::process\n        \n        CalcLocalCoords[\&quot;Measure engine local coordinates relative to parent&lt;br/&gt;(e.g., offset_LE, transform::to_local)\&quot;]:::process\n        \n        CalcOffsets[\&quot;Calculate offset_start and offset_end&lt;br/&gt;based on parent position and engine dimension\&quot;]:::process\n        \n        CreateSections[\&quot;Create pylon.sections (Nacelle &amp; Parent)&lt;br/&gt;Set origin using geom2::transform::to_local()&lt;br/&gt;Set chord_length\&quot;]:::process\n        \n        SetPylon[\&quot;Call: engine.set_pylon(pylon)\&quot;]:::process\n        \n        %% Flow\n        CheckVariant --&gt;|Turbofan&lt;Kerosene/LH2&gt;| TurbofanRoute\n        CheckVariant --&gt;|Openrotorfan&lt;Kerosene&gt;| OpenrotorRoute\n        \n        TurbofanRoute --&gt; CheckApplicability\n        OpenrotorRoute --&gt; CheckApplicability\n        \n        CheckApplicability --&gt;|Yes| ReturnEarly\n        CheckApplicability --&gt;|No| CallGetAttachment\n        \n        CallGetAttachment --&gt; CallGetProfile\n        CallGetProfile --&gt; InitPylon\n        InitPylon --&gt; CalcLocalCoords\n        CalcLocalCoords --&gt; CalcOffsets\n        CalcOffsets --&gt; CreateSections\n        CreateSections --&gt; SetPylon\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckVariant\n    \n    EndNode([End Default::operator() Complete&lt;br&gt;Return control to PropulsionDesign::run()]):::startEnd\n    ReturnEarly --&gt; EndNode\n    SetPylon --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CalcLocalCoords -. \&quot;Calls offset_LE() / MAC()\&quot; .-&gt; Ext1\n    CalcLocalCoords -. \&quot;Calls to_local()\&quot; .-&gt; Ext2\n    CreateSections -. \&quot;Calls to_local()\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YqNSAEV2ZDLSS5Zkn5YF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
