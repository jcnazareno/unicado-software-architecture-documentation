  <diagram id="wBQ10pszfUaNNqtVmVhC" name="this-&gt;get_attachement_points()">
    <mxGraphModel dx="6700" dy="2800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpWing fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpWingBody fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpFuselage fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    \n    style DepWing fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style DepWingBody fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style DepFuselage fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::get_attachment_points()&lt;br/&gt;File: src/pylon/default/default_pylon.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Attachment Points Calculation Workflow\&quot;]\n        direction TB\n        \n        CheckSupported{Is parent supported&lt;br/&gt;in detail::supported_parents?}:::decision\n        ThrowSupported[\&quot;Throw runtime_error&lt;br/&gt;Parent component not supported\&quot;]:::error\n        \n        SwitchParent{Switch on&lt;br/&gt;std::get&lt;Parent&gt;(parent)}:::decision\n        \n        %% Routes\n        CallWingAttach[\&quot;Call: detail::get_wing_attachment_points()\&quot;]:::process\n        CallWingBodyAttach[\&quot;Call: detail::get_wing_body_attachment_points()\&quot;]:::process\n        CallFuselageAttach[\&quot;Call: detail::get_fuselage_attachment_points()\&quot;]:::process\n        ReturnEmpty[\&quot;Return empty pair {}\&quot;]:::process\n        \n        %% Flow\n        CheckSupported --&gt;|No| ThrowSupported\n        CheckSupported --&gt;|Yes| SwitchParent\n        \n        SwitchParent --&gt;|Parent::Wing| CallWingAttach\n        SwitchParent --&gt;|Parent::WingBody| CallWingBodyAttach\n        SwitchParent --&gt;|Parent::Fuselage| CallFuselageAttach\n        SwitchParent --&gt;|Parent::Empennage / default| ReturnEmpty\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n    \n    %% ---------- Wing ----------\n    subgraph ExpWing [\&quot;Expanded View: get_wing_attachment_points()\&quot;]\n        direction TB\n        subgraph DepWing [\&quot;Dependencies (Wing)\&quot;]\n            Ext1_W[(geom2::measure::...&lt;br/&gt;libraries/aircraftGeometry2/processing/measure.h)]:::io\n            Ext2_W[(geom2::transform::...&lt;br/&gt;libraries/aircraftGeometry2/processing/transform.h)]:::io\n        end\n        W_LocalPos[\&quot;Call: geom2::transform::to_local(wing, position)\&quot;]:::process\n        W_LocalWing[\&quot;Call: geom2::measure::offset_LE(wing, local_position.z)\&quot;]:::process\n        W_CheckUnder{Is engine&lt;br/&gt;under wing?}:::decision\n        W_NacelleTop[\&quot;Call: geom2::measure::top(nacelle)\&quot;]:::process\n        W_NacelleBot[\&quot;Call: geom2::measure::bottom(nacelle)\&quot;]:::process\n        W_Global[\&quot;Call: geom2::transform::to_parent()&lt;br/&gt;for wing and nacelle\&quot;]:::process\n        W_Return[\&quot;Return {global_nacelle, global_wing}\&quot;]:::process\n        \n        W_LocalPos --&gt; W_LocalWing\n        W_LocalWing --&gt; W_CheckUnder\n        W_CheckUnder --&gt;|Yes| W_NacelleTop\n        W_CheckUnder --&gt;|No| W_NacelleBot\n        W_NacelleTop --&gt; W_Global\n        W_NacelleBot --&gt; W_Global\n        W_Global --&gt; W_Return\n        \n        %% Dep Links\n        W_LocalWing -.-&gt; Ext1_W\n        W_NacelleTop -.-&gt; Ext1_W\n        W_NacelleBot -.-&gt; Ext1_W\n        W_LocalPos -.-&gt; Ext2_W\n        W_Global -.-&gt; Ext2_W\n    end\n\n    %% ---------- WingBody ----------\n    subgraph ExpWingBody [\&quot;Expanded View: get_wing_body_attachment_points()\&quot;]\n        direction TB\n        subgraph DepWingBody [\&quot;Dependencies (WingBody)\&quot;]\n            Ext1_WB[(geom2::measure::...&lt;br/&gt;libraries/aircraftGeometry2/processing/measure.h)]:::io\n            Ext2_WB[(geom2::transform::...&lt;br/&gt;libraries/aircraftGeometry2/processing/transform.h)]:::io\n        end\n        WB_LocalPos[\&quot;Call: geom2::transform::to_local(wing, position)\&quot;]:::process\n        WB_LocalWing[\&quot;Call: geom2::measure::offset_LE(wing, local_position.z)\&quot;]:::process\n        WB_CheckUnder{Is engine&lt;br/&gt;under wing?}:::decision\n        WB_NacelleTop[\&quot;Call: geom2::measure::top(nacelle)\&quot;]:::process\n        WB_NacelleBot[\&quot;Call: geom2::measure::bottom(nacelle)\&quot;]:::process\n        WB_Shift[\&quot;Adjust local_wing.x using local_nacelle.x\&quot;]:::process\n        WB_Global[\&quot;Call: geom2::transform::to_parent()&lt;br/&gt;for wing and nacelle\&quot;]:::process\n        WB_Return[\&quot;Return {global_nacelle, global_wing}\&quot;]:::process\n        \n        WB_LocalPos --&gt; WB_LocalWing\n        WB_LocalWing --&gt; WB_CheckUnder\n        WB_CheckUnder --&gt;|Yes| WB_NacelleTop\n        WB_CheckUnder --&gt;|No| WB_NacelleBot\n        WB_NacelleTop --&gt; WB_Shift\n        WB_NacelleBot --&gt; WB_Shift\n        WB_Shift --&gt; WB_Global\n        WB_Global --&gt; WB_Return\n        \n        %% Dep Links\n        WB_LocalWing -.-&gt; Ext1_WB\n        WB_NacelleTop -.-&gt; Ext1_WB\n        WB_NacelleBot -.-&gt; Ext1_WB\n        WB_LocalPos -.-&gt; Ext2_WB\n        WB_Global -.-&gt; Ext2_WB\n    end\n\n    %% ---------- Fuselage ----------\n    subgraph ExpFuselage [\&quot;Expanded View: get_fuselage_attachment_points()\&quot;]\n        direction TB\n        subgraph DepFuselage [\&quot;Dependencies (Fuselage)\&quot;]\n            Ext1_F[(geom2::measure::...&lt;br/&gt;libraries/aircraftGeometry2/processing/measure.h)]:::io\n            Ext2_F[(geom2::transform::...&lt;br/&gt;libraries/aircraftGeometry2/processing/transform.h)]:::io\n        end\n        F_LocalPos[\&quot;Call: geom2::transform::to_local(fuselage, position)\&quot;]:::process\n        F_CheckRight{Is engine&lt;br/&gt;right of fuselage?}:::decision\n        F_FuselageRight[\&quot;Call: geom2::measure::right(fuselage)\&quot;]:::process\n        F_FuselageLeft[\&quot;Call: geom2::measure::left(fuselage)\&quot;]:::process\n        F_NacelleLeft[\&quot;Call: geom2::measure::left(nacelle)\&quot;]:::process\n        F_NacelleRight[\&quot;Call: geom2::measure::right(nacelle)\&quot;]:::process\n        F_Global[\&quot;Call: geom2::transform::to_parent()&lt;br/&gt;for fuselage and nacelle\&quot;]:::process\n        F_Return[\&quot;Return {global_nacelle, global_fuselage}\&quot;]:::process\n        \n        F_LocalPos --&gt; F_CheckRight\n        F_CheckRight --&gt;|Yes| F_FuselageRight\n        F_CheckRight --&gt;|No| F_FuselageLeft\n        F_FuselageRight --&gt; F_NacelleLeft\n        F_FuselageLeft --&gt; F_NacelleRight\n        F_NacelleLeft --&gt; F_Global\n        F_NacelleRight --&gt; F_Global\n        F_Global --&gt; F_Return\n        \n        %% Dep Links\n        F_FuselageRight -.-&gt; Ext1_F\n        F_FuselageLeft -.-&gt; Ext1_F\n        F_NacelleLeft -.-&gt; Ext1_F\n        F_NacelleRight -.-&gt; Ext1_F\n        F_LocalPos -.-&gt; Ext2_F\n        F_Global -.-&gt; Ext2_F\n    end\n\n    CallWingAttach -. \&quot;Expands to\&quot; .-&gt; W_LocalPos\n    CallWingBodyAttach -. \&quot;Expands to\&quot; .-&gt; WB_LocalPos\n    CallFuselageAttach -. \&quot;Expands to\&quot; .-&gt; F_LocalPos\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckSupported\n    \n    EndNode([End Default::get_attachment_points() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    ReturnEmpty --&gt; EndNode\n    \n    W_Return --&gt; EndNode\n    WB_Return --&gt; EndNode\n    F_Return --&gt; EndNode&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-K8ygHnrq2lUVR-BiPJN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="-K8ygHnrq2lUVR-BiPJN-96">
          <mxCell parent="-K8ygHnrq2lUVR-BiPJN-1" style="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
