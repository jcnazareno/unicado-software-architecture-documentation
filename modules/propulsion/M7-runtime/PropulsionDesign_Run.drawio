  <diagram id="hDG6m3yQ_L0hCY0ZHHU4" name="this-&gt;integrate_into_wing_body()">
    <mxGraphModel dx="5025" dy="2100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpSelectWing fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::measure::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/measure.h))]:::io\n        Ext2[(geom2::transform::to_parent&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/transform.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::integrate_into_wing_body()&lt;br/&gt;Entry Point from Default::operator()]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Wing-Body Integration Position Calculation Workflow\&quot;]\n        direction TB\n        \n        CheckVertical{Is engine vertical&lt;br/&gt;position Over?}:::decision\n        \n        CallSelectWing[\&quot;Subroutine: this-&gt;select_wing()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        \n        CheckOrientation{Is wing oriented in&lt;br/&gt;Y-direction?}:::decision\n        ThrowOrientationErr[\&quot;Throw runtime_error&lt;br/&gt;Wing orientation not applicable\&quot;]:::error\n        \n        MeasureSpan[\&quot;Call: geom2::measure::span(wing)\&quot;]:::process\n        InitBounds[\&quot;Initialize no_placement vector&lt;br/&gt;with -span/2 and span/2\&quot;]:::process\n        \n        LoopEmpennage{For each empennage&lt;br/&gt;in aircraft}:::decision\n        TransformEmpennage[\&quot;Call: geom2::transform::to_parent()&lt;br/&gt;Get front and back section origins\&quot;]:::process\n        AddBounds[\&quot;Calculate projected span&lt;br/&gt;Add collision bounds to no_placement\&quot;]:::process\n        \n        SortBounds[\&quot;std::sort(no_placement)\&quot;]:::process\n        \n        CheckSymmetrical{Is empennage placement&lt;br/&gt;symmetrical?}:::decision\n        ThrowSymmErr[\&quot;Throw runtime_error&lt;br/&gt;Non-symmetrical empennage\&quot;]:::error\n        \n        CheckEngines{Switch on&lt;br/&gt;this-&gt;n_engines_.wing}:::decision\n        \n        %% Case 1 Engine\n        CheckCollision1{Space check against&lt;br/&gt;diameter_max (Case 1)}:::decision\n        ThrowCollision1[\&quot;Throw runtime_error&lt;br/&gt;Empennage-engine collision\&quot;]:::error\n        CalcSpan1[\&quot;span_engine = 0.0\&quot;]:::process\n        \n        %% Case 2 Engines\n        CheckCollision2{Check spacing in&lt;br/&gt;no_placement (Case 2)}:::decision\n        ThrowCollision2[\&quot;Throw runtime_error&lt;br/&gt;No available space over wing\&quot;]:::error\n        CalcSpan2[\&quot;Calculate span_engine&lt;br/&gt;and span_offset\&quot;]:::process\n        \n        %% Shared End Calculation\n        MeasureLocalCoords[\&quot;Call: geom2::measure::chord()&lt;br/&gt;geom2::measure::offset_LE()\&quot;]:::process\n        CalcLocalPos[\&quot;Calculate local chord_engine and height_engine\&quot;]:::process\n        CreatePos[\&quot;auto position = {chord, height, span}\&quot;]:::process\n        \n        ApplyShift[\&quot;Apply inline usershift_x, usershift_y, usershift_z\&quot;]:::process\n        \n        TransformToGlobal[\&quot;Call: geom2::transform::to_parent(wing, position)\&quot;]:::process\n        SetPos[\&quot;Call: engine.set_position()\&quot;]:::process\n        IncDone[\&quot;Increment engines_done.wing\&quot;]:::process\n        \n        %% Flow\n        CheckVertical --&gt;|Yes| CallSelectWing\n        CheckVertical --&gt;|No| EndNode\n        \n        CallSelectWing --&gt; CheckOrientation\n        CheckOrientation --&gt;|No| ThrowOrientationErr\n        CheckOrientation --&gt;|Yes| MeasureSpan\n        MeasureSpan --&gt; InitBounds\n        InitBounds --&gt; LoopEmpennage\n        \n        LoopEmpennage --&gt;|Next Item| TransformEmpennage\n        TransformEmpennage --&gt; AddBounds\n        AddBounds --&gt; LoopEmpennage\n        \n        LoopEmpennage --&gt;|Done| SortBounds\n        SortBounds --&gt; CheckSymmetrical\n        \n        CheckSymmetrical --&gt;|No| ThrowSymmErr\n        CheckSymmetrical --&gt;|Yes| CheckEngines\n        \n        CheckEngines --&gt;|1| CheckCollision1\n        CheckEngines --&gt;|2| CheckCollision2\n        \n        CheckCollision1 --&gt;|Collision| ThrowCollision1\n        CheckCollision1 --&gt;|Clear| CalcSpan1\n        CalcSpan1 --&gt; MeasureLocalCoords\n        \n        CheckCollision2 --&gt;|No Space| ThrowCollision2\n        CheckCollision2 --&gt;|Clear| CalcSpan2\n        CalcSpan2 --&gt; MeasureLocalCoords\n        \n        MeasureLocalCoords --&gt; CalcLocalPos\n        CalcLocalPos --&gt; CreatePos\n        CreatePos --&gt; ApplyShift\n        ApplyShift --&gt; TransformToGlobal\n        TransformToGlobal --&gt; SetPos\n        SetPos --&gt; IncDone\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n    subgraph ExpSelectWing [\&quot;Expanded View: this-&gt;select_wing()\&quot;]\n        direction TB\n        SW_CheckSize{Is wings.size() != 1?}:::decision\n        SW_ReadConfig[\&quot;Read config: name_wing_engines/value\&quot;]:::process\n        SW_FindWing{Find wing&lt;br/&gt;by name}:::decision\n        SW_SortWing[\&quot;std::rotate to front\&quot;]:::process\n        SW_Warn[\&quot;utility::print()&lt;br/&gt;Warning: Taking first wing\&quot;]:::error\n        SW_Return[\&quot;Return first wing\&quot;]:::process\n        \n        SW_CheckSize --&gt;|Yes| SW_ReadConfig\n        SW_CheckSize --&gt;|No| SW_Return\n        SW_ReadConfig --&gt; SW_FindWing\n        SW_FindWing --&gt;|Found| SW_SortWing\n        SW_FindWing --&gt;|Not Found| SW_Warn\n        SW_SortWing --&gt; SW_Return\n        SW_Warn --&gt; SW_Return\n    end\n\n    CallSelectWing -. \&quot;Expands to\&quot; .-&gt; SW_CheckSize\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckVertical\n    \n    EndNode([End Default::integrate_into_wing_body() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    IncDone --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    MeasureSpan -. \&quot;Calls span()\&quot; .-&gt; Ext1\n    MeasureLocalCoords -. \&quot;Calls chord() / offset_LE()\&quot; .-&gt; Ext1\n    TransformEmpennage -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2\n    TransformToGlobal -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TJKTsluDgxb9Btvyf5zN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
