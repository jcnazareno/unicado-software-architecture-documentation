        </UserObject>
        <UserObject label="Entry / Exit" mermaidId="n:L1" mermaidBaseStyle="html=1;rounded=1;whiteSpace=wrap;arcSize=50;strokeWidth=2;fillColor=#C8C8FF;strokeColor=#7A7AD8;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Entry / Exit" id="nZZf3rTw16WzRdIJFEYm-54">
          <mxCell parent="nZZf3rTw16WzRdIJFEYm-53" style="html=1;rounded=1;whiteSpace=wrap;arcSize=50;strokeWidth=2;fillColor=#C8C8FF;strokeColor=#7A7AD8;fontColor=#333333;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="39" width="107" x="82" y="45" as="geometry" />
