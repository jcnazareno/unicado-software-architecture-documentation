  <diagram id="SJxkHY-CPjV16tK2IaUU" name="this-&gt;get_section_profile()">
    <mxGraphModel dx="2513" dy="1050" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::io::read_dat_file&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/io/dat.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::get_section_profile()&lt;br/&gt;File: src/pylon/default/default_pylon.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Pylon Profile Geometry Retrieval Workflow\&quot;]\n        direction TB\n        \n        ReadConfig[\&quot;Read configuration: profile_name&lt;br/&gt;from this-&gt;section_profiles\&quot;]:::process\n        \n        CheckFile{Does geometry_directory() /&lt;br/&gt;profile_name exist?}:::decision\n        \n        %% File Exists Branch\n        TryRead[\&quot;try { profile.set_contour(geom2::io::read_dat_file) }\&quot;]:::process\n        CatchRead[\&quot;catch: Throw exception\&quot;]:::error\n        \n        %% File Not Exists Branch\n        TryCreate[\&quot;try { write default airfoil coordinates to file }\&quot;]:::process\n        CreateRead[\&quot;profile.set_contour(geom2::io::read_dat_file)\&quot;]:::process\n        CatchCreate[\&quot;catch: Throw exception\&quot;]:::error\n        \n        SetName[\&quot;profile.name = profile_name.substr(...)\&quot;]:::process\n        ReturnProfile[\&quot;Return profile\&quot;]:::process\n        \n        %% Flow\n        ReadConfig --&gt; CheckFile\n        \n        %% Exists\n        CheckFile --&gt;|Yes| TryRead\n        TryRead --&gt;|Success| SetName\n        TryRead --&gt;|Exception| CatchRead\n        \n        %% Not Exists\n        CheckFile --&gt;|No| TryCreate\n        TryCreate --&gt;|Success| CreateRead\n        CreateRead --&gt; SetName\n        TryCreate --&gt;|Exception| CatchCreate\n        CreateRead --&gt;|Exception| CatchCreate\n        \n        SetName --&gt; ReturnProfile\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ReadConfig\n    \n    EndNode([End Default::get_section_profile() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    ReturnProfile --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    TryRead -. \&quot;Calls read_dat_file()\&quot; .-&gt; Ext1\n    CreateRead -. \&quot;Calls read_dat_file()\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WBDWCAPujqcLjFvnVS_c-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
