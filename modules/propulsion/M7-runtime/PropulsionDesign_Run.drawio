  <diagram id="84MPPEt24_t6mJKNtc1V" name="engine_unscaled.calculate_N1_with_penalties()">
    <mxGraphModel dx="8354" dy="2800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpCorrection fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpLower fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpUpper fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpOfftake fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpRating fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpBounds fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine Call]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction LR\n        Ext1[(atmosphere&lt;br/&gt;External Method outside of Propulsion Design (libraries/atmosphere/include/atmosphere/atmosphere.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Engine::calculate_N1_with_penalties()&lt;br/&gt;File: libraries/engine/src/engine.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Main Pipeline: calculate_N1_with_penalties()\&quot;]\n        direction TB\n        \n        SetAlt[\&quot;Set Altitude: this-&gt;op_.altitude = flight_level\&quot;]:::process\n        SetMach[\&quot;Set Mach Number: this-&gt;op_.Mach = mach_number\&quot;]:::process\n        \n        CallSetCorrection[\&quot;Subroutine: this-&gt;set_correction_factors()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallLowerLimit[\&quot;Subroutine: this-&gt;set_lower_N1_limit()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallUpperLimit[\&quot;Subroutine: this-&gt;set_upper_N1_limit()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallOfftake[\&quot;Subroutine: this-&gt;calculate_offtake_correction()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallSetN1[\&quot;Subroutine: this-&gt;set_N1_to_rating()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        CallCheckBounds[\&quot;Subroutine: this-&gt;check_offtake_boundaries()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        \n        %% Flow Connections\n        SetAlt --&gt; SetMach\n        SetMach --&gt; CallSetCorrection\n        CallSetCorrection --&gt; CallLowerLimit\n        CallLowerLimit --&gt; CallUpperLimit\n        CallUpperLimit --&gt; CallOfftake\n        CallOfftake --&gt; CallSetN1\n        CallSetN1 --&gt; CallCheckBounds\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n    \n    %% 1. set_correction_factors\n    subgraph ExpCorrection [\&quot;Expanded View: set_correction_factors() (Internal Method within File)\&quot;]\n        direction TB\n        EC_Get[\&quot;Extract atmospheric data (temp, pressure)\&quot;]:::process\n        EC_CalcN[\&quot;Calculate Spool Speed Correction (N_correction_)\&quot;]:::process\n        EC_CalcW[\&quot;Calculate Mass Flow Correction (W_correction_)\&quot;]:::process\n        EC_CalcT[\&quot;Calculate Temperature Correction (T_correction_)\&quot;]:::process\n        \n        EC_Get --&gt; EC_CalcN --&gt; EC_CalcW --&gt; EC_CalcT\n    end\n    CallSetCorrection -. \&quot;Expands to\&quot; .-&gt; EC_Get\n    \n    %% 2. set_lower_N1_limit\n    subgraph ExpLower [\&quot;Expanded View: set_lower_N1_limit() (Internal Method within File)\&quot;]\n        direction TB\n        EL_Init[\&quot;Initialize N_lower_limit_ = engine_data_ idle\&quot;]:::process\n        EL_Loop{While thrust &lt; 0.0&lt;br/&gt;(Invalid Thrust)}:::decision\n        EL_Inc[\&quot;op_.N += N1_step_\&quot;]:::process\n        \n        EL_Init --&gt; EL_Loop\n        EL_Loop --&gt;|Yes| EL_Inc\n        EL_Inc --&gt; EL_Loop\n    end\n    CallLowerLimit -. \&quot;Expands to\&quot; .-&gt; EL_Init\n\n    %% 3. set_upper_N1_limit\n    subgraph ExpUpper [\&quot;Expanded View: set_upper_N1_limit() (Internal Method within File)\&quot;]\n        direction TB\n        EU_Init[\&quot;Initialize N_upper_limit_ = engine_data_ max\&quot;]:::process\n        EU_Loop{While thrust &lt; 0.0&lt;br/&gt;(Invalid Thrust)}:::decision\n        EU_Dec[\&quot;op_.N -= N1_step_\&quot;]:::process\n        EU_Check{\&quot;Is N_upper_limit_ &lt; op_.N?\&quot;}:::decision\n        EU_Final[\&quot;op_.N = N_upper_limit_\&quot;]:::process\n        \n        EU_Init --&gt; EU_Loop\n        EU_Loop --&gt;|Yes| EU_Dec\n        EU_Dec --&gt; EU_Loop\n        EU_Loop --&gt;|No| EU_Check\n        EU_Check --&gt;|Yes| EU_Final\n    end\n    CallUpperLimit -. \&quot;Expands to\&quot; .-&gt; EU_Init\n    \n    %% 4. calculate_offtake_correction\n    subgraph ExpOfftake [\&quot;Expanded View: calculate_offtake_correction() (Internal Method within File)\&quot;]\n        direction TB\n        EO_CallBounds[\&quot;Subroutine: this-&gt;check_offtake_boundaries()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        EO_Mass[\&quot;Calculate MassFlow\&quot;]:::process\n        EO_Thrust[\&quot;Calculate thrust_correction_bleed_\&quot;]:::process\n        EO_Shaft[\&quot;Calculate shaft_offtake_factor_\&quot;]:::process\n        EO_Fuel[\&quot;Calculate fuel_flow_factor_shaft_offtakes_\&quot;]:::process\n        \n        EO_CallBounds --&gt; EO_Mass --&gt; EO_Thrust --&gt; EO_Shaft --&gt; EO_Fuel\n    end\n    CallOfftake -. \&quot;Expands to\&quot; .-&gt; EO_CallBounds\n    \n    %% 5. set_N1_to_rating\n    subgraph ExpRating [\&quot;Expanded View: set_N1_to_rating() (Internal Method within File)\&quot;]\n        direction TB\n        ER_TO{Is thrustRating&lt;br/&gt;== &#39;takeoff&#39;?}:::decision\n        ER_SetTO[\&quot;op_.N = max(upper, lower)\&quot;]:::process\n        \n        ER_MCT{Is thrustRating&lt;br/&gt;== &#39;maximum_continuous&#39;?}:::decision\n        ER_SetMCT[\&quot;op_.N = max(upper, lower)\&quot;]:::process\n        \n        ER_Climb{Is thrustRating&lt;br/&gt;== &#39;climb&#39;?}:::decision\n        ER_SetClimb[\&quot;op_.N = max(climb, lower)\&quot;]:::process\n        \n        ER_Cruise{Is thrustRating&lt;br/&gt;== &#39;cruise&#39;?}:::decision\n        ER_SetCruise[\&quot;op_.N = max(cruise, lower)\&quot;]:::process\n        \n        ER_Idle{Is thrustRating&lt;br/&gt;== &#39;idle&#39;?}:::decision\n        ER_SetIdle[\&quot;op_.N = lower\&quot;]:::process\n        \n        ER_Err[\&quot;Throw Exception: Rating not known\&quot;]:::error\n        \n        ER_TO --&gt;|Yes| ER_SetTO\n        ER_TO --&gt;|No| ER_MCT\n        ER_MCT --&gt;|Yes| ER_SetMCT\n        ER_MCT --&gt;|No| ER_Climb\n        ER_Climb --&gt;|Yes| ER_SetClimb\n        ER_Climb --&gt;|No| ER_Cruise\n        ER_Cruise --&gt;|Yes| ER_SetCruise\n        ER_Cruise --&gt;|No| ER_Idle\n        ER_Idle --&gt;|Yes| ER_SetIdle\n        ER_Idle --&gt;|No| ER_Err\n    end\n    CallSetN1 -. \&quot;Expands to\&quot; .-&gt; ER_TO\n    \n    %% 6. check_offtake_boundaries\n    subgraph ExpBounds [\&quot;Expanded View: check_offtake_boundaries() (Internal Method within File)\&quot;]\n        direction TB\n        EB_Mass[\&quot;Calculate coreMassFlow\&quot;]:::process\n        EB_Bleed[\&quot;Calculate relBleed\&quot;]:::process\n        EB_ChkBleed{Is relBleed &gt; max_bleed?}:::decision\n        EB_WarnBleed[\&quot;Call std::cout&lt;br/&gt;&#39;Bleed air extraction too high.&#39;\&quot;]:::error\n        EB_ChkShaft{Is shaftPower &gt; max_shaft?}:::decision\n        EB_WarnShaft[\&quot;Call std::cout&lt;br/&gt;&#39;Shaft power extraction too high.&#39;\&quot;]:::error\n        \n        EB_Mass --&gt; EB_Bleed --&gt; EB_ChkBleed\n        EB_ChkBleed --&gt;|Yes| EB_WarnBleed\n        EB_ChkBleed --&gt;|No| EB_ChkShaft\n        EB_WarnBleed --&gt; EB_ChkShaft\n        EB_ChkShaft --&gt;|Yes| EB_WarnShaft\n    end\n    CallCheckBounds -. \&quot;Expands to\&quot; .-&gt; EB_Mass\n    \n    %% Note: calculate_offtake_correction internally calls check_offtake_boundaries as well!\n    EO_CallBounds -. \&quot;Expands to\&quot; .-&gt; EB_Mass\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; SetAlt\n    \n    EndNode([End calculate_N1_with_penalties() Complete&lt;br&gt;Returns control to caller]):::startEnd\n    CallCheckBounds --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    EC_Get -. \&quot;Calls atm.getTemperature() / atm.getPressure()\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s5KjHr0cAW_94wtgJcYg-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
