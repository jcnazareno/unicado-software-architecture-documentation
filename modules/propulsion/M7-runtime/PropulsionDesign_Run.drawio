  <diagram id="c9UCeRAWNbdrASBU5BnV" name="this-&gt;integrate_into_wing()">
    <mxGraphModel dx="2871" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpSelectWing fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpSelectFuselage fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpCalcSpan fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style ExpUserShift fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n        L6[Subroutine]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(geom2::measure::...&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/measure.h))]:::io\n        Ext2[(geom2::transform::to_parent&lt;br/&gt;External Method outside of Propulsion Design (libraries/aircraftGeometry2/include/aircraftGeometry2/processing/transform.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Default::integrate_into_wing()&lt;br/&gt;Entry Point from Default::operator()]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 3)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Wing Integration Position Calculation Workflow\&quot;]\n        direction TB\n        \n        CallSelectWing[\&quot;Subroutine: this-&gt;select_wing()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        CallSelectFuselage[\&quot;Subroutine: this-&gt;select_fuselage()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        \n        CheckOrientation{Is wing oriented in&lt;br/&gt;Y-direction?}:::decision\n        ThrowOrientationErr[\&quot;Throw runtime_error&lt;br/&gt;Wing orientation not applicable\&quot;]:::error\n        \n        CheckOuter{Is engine parent&lt;br/&gt;in this-&gt;parents_placed?&lt;br/&gt;(is_outer)}:::decision\n        \n        CheckEngines{Switch on&lt;br/&gt;this-&gt;n_engines_.wing}:::decision\n        CheckSpace{Is there space for&lt;br/&gt;outer engine?}:::decision\n        ThrowSpaceErr[\&quot;Throw runtime_error&lt;br/&gt;No space on wing\&quot;]:::error\n        \n        %% Geometry Measurement Block\n        MeasureAircraft[\&quot;Call: geom2::measure::span(wing)&lt;br/&gt;geom2::measure::width_max(fuselage)\&quot;]:::process\n        \n        CallCalcSpan[\&quot;Subroutine: this-&gt;calculate_span_position() / _openrotor()&lt;br/&gt;Internal Method within File\&quot;]:::subroutine\n        \n        MeasureChord[\&quot;Call: geom2::measure::chord()&lt;br/&gt;geom2::measure::offset_LE()\&quot;]:::process\n        \n        CalcLocalPos[\&quot;Calculate local chord_engine and height_engine&lt;br/&gt;based on engine variant and position\&quot;]:::process\n        \n        CreatePos[\&quot;auto position = {chord, height, span}\&quot;]:::process\n        \n        CallUserShift[\&quot;Subroutine: this-&gt;calculate_user_shift()&lt;br/&gt;Internal Method within File (src/integration/default/default_integration.cpp)\&quot;]:::subroutine\n        \n        CheckLeft{Is engine Lateral::Left?}:::decision\n        NegateZ[\&quot;position.z = -position.z\&quot;]:::process\n        \n        TransformToGlobal[\&quot;Call: geom2::transform::to_parent(wing, position)\&quot;]:::process\n        \n        SetPos[\&quot;Call: engine.set_position()\&quot;]:::process\n        IncDone[\&quot;Increment engines_done.wing\&quot;]:::process\n        \n        %% Flow\n        CallSelectWing --&gt; CallSelectFuselage\n        CallSelectFuselage --&gt; CheckOrientation\n        CheckOrientation --&gt;|No| ThrowOrientationErr\n        CheckOrientation --&gt;|Yes| CheckOuter\n        CheckOuter --&gt; CheckEngines\n        \n        CheckEngines --&gt;|2 or 4 engines| CheckSpace\n        CheckEngines --&gt;|default| ThrowSpaceErr\n        \n        CheckSpace --&gt;|No space| ThrowSpaceErr\n        CheckSpace --&gt;|Valid space| MeasureAircraft\n        \n        MeasureAircraft --&gt; CallCalcSpan\n        CallCalcSpan --&gt; MeasureChord\n        MeasureChord --&gt; CalcLocalPos\n        CalcLocalPos --&gt; CreatePos\n        CreatePos --&gt; CallUserShift\n        \n        CallUserShift --&gt; CheckLeft\n        CheckLeft --&gt;|Yes| NegateZ\n        CheckLeft --&gt;|No| TransformToGlobal\n        NegateZ --&gt; TransformToGlobal\n        \n        TransformToGlobal --&gt; SetPos\n        SetPos --&gt; IncDone\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEWS (Level 4 Subroutines)\n    %% ==========================================\n    subgraph ExpSelectWing [\&quot;Expanded View: this-&gt;select_wing()\&quot;]\n        direction TB\n        SW_CheckSize{Is wings.size() != 1?}:::decision\n        SW_ReadConfig[\&quot;Read config: name_wing_engines/value\&quot;]:::process\n        SW_FindWing{Find wing&lt;br/&gt;by name}:::decision\n        SW_SortWing[\&quot;std::rotate to front\&quot;]:::process\n        SW_Warn[\&quot;utility::print()&lt;br/&gt;Warning: Taking first wing\&quot;]:::error\n        SW_Return[\&quot;Return first wing\&quot;]:::process\n        \n        SW_CheckSize --&gt;|Yes| SW_ReadConfig\n        SW_CheckSize --&gt;|No| SW_Return\n        SW_ReadConfig --&gt; SW_FindWing\n        SW_FindWing --&gt;|Found| SW_SortWing\n        SW_FindWing --&gt;|Not Found| SW_Warn\n        SW_SortWing --&gt; SW_Return\n        SW_Warn --&gt; SW_Return\n    end\n\n    subgraph ExpSelectFuselage [\&quot;Expanded View: this-&gt;select_fuselage()\&quot;]\n        direction TB\n        SF_CheckSize{Is fuselages.size() != 1?}:::decision\n        SF_Throw[\&quot;Throw runtime_error\&quot;]:::error\n        SF_Return[\&quot;Return first fuselage\&quot;]:::process\n        \n        SF_CheckSize --&gt;|Yes| SF_Throw\n        SF_CheckSize --&gt;|No| SF_Return\n    end\n\n    subgraph ExpCalcSpan [\&quot;Expanded View: this-&gt;calculate_span_position() / _openrotor()\&quot;]\n        direction TB\n        CS_CheckEngine{Switch on&lt;br/&gt;this-&gt;n_engines_.wing}:::decision\n        CS_Calc2[\&quot;Calculate inner span&lt;br/&gt;f(width_fuselage, diameter)\&quot;]:::process\n        CS_CheckOuter{is_outer?}:::decision\n        CS_Calc4Outer[\&quot;Calculate outer span&lt;br/&gt;f(wing_span)\&quot;]:::process\n        CS_Calc4Inner[\&quot;Calculate inner span&lt;br/&gt;f(wing_span, width_fuselage, diameter)\&quot;]:::process\n        CS_Return[\&quot;Return span_engine\&quot;]:::process\n        \n        CS_CheckEngine --&gt;|2| CS_Calc2\n        CS_CheckEngine --&gt;|4| CS_CheckOuter\n        CS_Calc2 --&gt; CS_Return\n        CS_CheckOuter --&gt;|Yes| CS_Calc4Outer\n        CS_CheckOuter --&gt;|No| CS_Calc4Inner\n        CS_Calc4Outer --&gt; CS_Return\n        CS_Calc4Inner --&gt; CS_Return\n    end\n\n    subgraph ExpUserShift [\&quot;Expanded View: this-&gt;calculate_user_shift()\&quot;]\n        direction TB\n        US_Read[\&quot;Read usershift_x, usershift_y, usershift_z&lt;br/&gt;from config\&quot;]:::process\n        US_Apply[\&quot;position.x += usershift_x&lt;br/&gt;position.y += usershift_z&lt;br/&gt;position.z -= usershift_y\&quot;]:::process\n        US_Return[\&quot;Return position\&quot;]:::process\n        \n        US_Read --&gt; US_Apply\n        US_Apply --&gt; US_Return\n    end\n\n    CallSelectWing -. \&quot;Expands to\&quot; .-&gt; SW_CheckSize\n    CallSelectFuselage -. \&quot;Expands to\&quot; .-&gt; SF_CheckSize\n    CallCalcSpan -. \&quot;Expands to\&quot; .-&gt; CS_CheckEngine\n    CallUserShift -. \&quot;Expands to\&quot; .-&gt; US_Read\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CallSelectWing\n    \n    EndNode([End Default::integrate_into_wing() Complete&lt;br&gt;Return control to Default::operator()]):::startEnd\n    IncDone --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    MeasureAircraft -. \&quot;Calls span() / width_max()\&quot; .-&gt; Ext1\n    MeasureChord -. \&quot;Calls chord() / offset_LE()\&quot; .-&gt; Ext1\n    TransformToGlobal -. \&quot;Calls to_parent()\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6XYCL2jPrwXxNjSyLoFH-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
