        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style MainTryBlock fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Start / End / Termination]):::startEnd\n        L2[Execution Process / Action]:::process\n        L3[(Dependencies)]:::io\n        L4{Decision / Condition}:::decision\n        L5[Error / Failure]:::error\n        L6[[Subroutine]]:::subroutine\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Project &amp; External Dependencies\&quot;]\n        direction LR\n        Dep1[(toolinfo.h&lt;br/&gt;Local Header)]:::io\n        Dep2[(propulsion_design.h&lt;br/&gt;Local Header)]:::io\n        Dep3[(moduleBasics/module.h&lt;br/&gt;UNICADO Core API)]:::io\n        Dep4[(iostream &amp; exception&lt;br/&gt;C++ Standard Library)]:::io\n    end\n\n    %% ==========================================\n    %% SYSTEM BOOT ENTRY POINT\n    %% ==========================================\n    Node1([System Boot&lt;br&gt;Initiates executable binary&lt;br&gt;File: main.cpp]):::startEnd\n    \n    subgraph MainTryBlock[\&quot;Main Try-Catch Block\&quot;]\n        %% ==========================================\n        %% PROPULSION DESIGN OBJECT CREATION\n        %% ==========================================\n        Node1A[Create PropulsionDesign Object&lt;br&gt;Constructor with argc, argv&lt;br&gt;TOOL_NAME, TOOL_VERSION&lt;br&gt;File: main.cpp]:::process\n        \n        Node1B[Invoke Parent Module Constructor&lt;br&gt;via initializer list&lt;br&gt;Parses arguments and loads XML&lt;br&gt;File: moduleBasics/module.h]:::process\n        \n        Node1A --&gt; Node1B\n\n        %% ==========================================\n        %% MODULE LIFECYCLE EXECUTION WRAPPER\n        %% ==========================================\n        Node2[Execute Module Lifecycle&lt;br&gt;Module::execute orchestrates pipeline&lt;br&gt;File: moduleBasics/module.h]:::process\n        \n        %% ==========================================\n        %% DELEGATION TO PROPULSION_DESIGN.CPP\n        %% ==========================================\n        Node3[[Delegate to propulsion_design.cpp&lt;br&gt;(Click to view detailed lifecycle diagram)&lt;br&gt;Phases: initialize, run, update, report, save]]:::subroutine\n        \n        Node1B --&gt; Node2\n        Node2 --&gt; Node3\n    end\n\n    Node1 --&gt; Node1A\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    Node1A -. \&quot;Includes\&quot; .-&gt; Dep1\n    Node1A -. \&quot;Includes\&quot; .-&gt; Dep2\n    Node1B -. \&quot;Inherits\&quot; .-&gt; Dep3\n    Node2 -. \&quot;Inherits\&quot; .-&gt; Dep3\n\n    %% ==========================================\n    %% EXCEPTION HANDLING\n    %% ==========================================\n    ExceptionCheck{Exception thrown during&lt;br&gt;construction or execution?}:::decision\n    \n    Node3 --&gt; ExceptionCheck\n    \n    CatchError1[Catch std::string error&lt;br&gt;Print to stderr]:::error\n    CatchError2[Catch std::exception&lt;br&gt;Print message to stderr]:::error\n    CatchError3[Catch unknown error&lt;br&gt;Print generic message]:::error\n    \n    ExceptionCheck --&gt;|std::string| CatchError1\n    ExceptionCheck --&gt;|std::exception| CatchError2\n    ExceptionCheck --&gt;|Other| CatchError3\n\n    CatchError1 -. \&quot;Uses std::cerr\&quot; .-&gt; Dep4\n    CatchError2 -. \&quot;Uses std::cerr\&quot; .-&gt; Dep4\n\n    %% ==========================================\n    %% SUCCESS vs FAILURE PATHS\n    %% ==========================================\n    SuccessPath[execute returns&lt;br&gt;success status]:::process\n    FailurePath[Return EXIT_FAILURE]:::error\n    \n    ExceptionCheck --&gt;|No exception| SuccessPath\n    \n    CatchError1 --&gt; FailurePath\n    CatchError2 --&gt; FailurePath\n    CatchError3 --&gt; FailurePath\n    \n    %% ==========================================\n    %% FINAL TERMINATION\n    %% ==========================================\n    Node8([Program Termination&lt;br&gt;Dispose resources and exit&lt;br&gt;Success Path: exit code 0&lt;br&gt;Failure Path: EXIT_FAILURE 1&lt;br&gt;File: main.cpp]):::startEnd\n    \n    SuccessPath --&gt; Node8\n    FailurePath --&gt; Node8\n    \n    %% ==========================================\n    %% LINKS\n    %% ==========================================\n    click Node3 \&quot;propulsion_design_diagram.md\&quot; \&quot;View propulsion_design.cpp diagram\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="x62Qow0ktxxTaKs0L4g4-1">
