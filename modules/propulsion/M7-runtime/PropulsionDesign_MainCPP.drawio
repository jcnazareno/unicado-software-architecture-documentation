        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[[Subroutine ]]:::subroutine\n        L3[(Data / Dependencies)]:::io\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(moduleBasics/module.h&lt;br/&gt;External UNICADO Core API)]:::io\n        Ext2[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n        Ext3[(C++ Standard Library&lt;br/&gt;algorithm, format, vector, etc.)]:::io\n        Int1[(engine_design, nacelle, pylon, mass&lt;br/&gt;Local Sub-folder Headers)]:::io\n        Int2[(io/aircraft_xml.h&lt;br/&gt;Local Header)]:::io\n    end\n\n    %% ==========================================\n    %% SYSTEM ENTRY\n    %% ==========================================\n    Entry([Start Module Execution&lt;br&gt;Invoked by main.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;propulsion_design.cpp - High Level Lifecycle Pipeline\&quot;]\n        direction TB\n        \n        Phase1[[Phase 1: initialize()&lt;br&gt;(Click to view detailed diagram)]]:::subroutine\n        Phase2[[Phase 2: run()&lt;br&gt;(Click to view detailed diagram)]]:::subroutine\n        Phase3[[Phase 3: update()&lt;br&gt;(Click to view detailed diagram)]]:::subroutine\n        Phase4[[Phase 4: report()&lt;br&gt;(Click to view detailed diagram)]]:::subroutine\n        Phase5[[Phase 5: save()&lt;br&gt;(Click to view detailed diagram)]]:::subroutine\n        \n        Phase1 --&gt; Phase2 --&gt; Phase3 --&gt; Phase4 --&gt; Phase5\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; Phase1\n    \n    EndNode([End Module Execution&lt;br&gt;Return Success to main.cpp]):::startEnd\n    Phase5 --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    Phase1 -. \&quot;Reads XML\&quot; .-&gt; Ext2\n    Phase1 -. \&quot;Uses\&quot; .-&gt; Ext1\n    Phase3 -. \&quot;Modifies XML via\&quot; .-&gt; Int2\n    Phase5 -. \&quot;Saves XML via\&quot; .-&gt; Ext2\n    \n    Phase1 -. \&quot;Instantiates\&quot; .-&gt; Int1\n    Phase2 -. \&quot;Executes\&quot; .-&gt; Int1\n    Phase3 -. \&quot;Updates\&quot; .-&gt; Int1\n    Phase4 -. \&quot;Reports\&quot; .-&gt; Int1\n    Phase5 -. \&quot;Saves\&quot; .-&gt; Int1\n    \n    Phase1 -. \&quot;Uses\&quot; .-&gt; Ext3\n    Phase3 -. \&quot;Uses std::transform\&quot; .-&gt; Ext3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" link="https://app.diagrams.net/?tags=%7B%7D&amp;lightbox=1&amp;highlight=0000ff&amp;edit=_blank&amp;layers=1&amp;nav=1&amp;dark=auto#Hjcnazareno%2FUNICADO_Architecture_Recovery%2Fmain%2FPropulsionDesign_Initialize.drawio" linkTarget="_blank" id="htFGDo8Qcvwzip5XjHWI-1">
