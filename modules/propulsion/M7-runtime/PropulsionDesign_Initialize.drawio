      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Method Check}:::decision\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start nacelle_designer-&gt;initialize()&lt;br/&gt;Entry Point from propulsion_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Nacelle Initialization Workflow\&quot;]\n        direction TB\n        \n        LoopNodes{For each propulsion node&lt;br/&gt;in configuration XML?}:::decision\n        \n        ReadConfig[Read &#39;ID&#39; attribute and&lt;br/&gt;&#39;nacelle/profile/value&#39;]:::process\n        \n        ToLower[Transform strings to lower case&lt;br/&gt;via std::transform]:::process\n        \n        CheckID{Is ID == &#39;default&#39;?}:::decision\n        \n        SetDefault[\&quot;Assign shape to default index&lt;br/&gt;this-&gt;section_shapes(-1) = shape\&quot;]:::process\n        \n        ParseSetSpecific[\&quot;Parse ID via std::stoi and assign&lt;br/&gt;this-&gt;section_shapes(engine_id) = shape\&quot;]:::process\n\n        %% Flow\n        LoopNodes --&gt;|Next Node| ReadConfig\n        ReadConfig --&gt; ToLower\n        ToLower --&gt; CheckID\n        \n        CheckID --&gt;|Yes| SetDefault\n        CheckID --&gt;|No| ParseSetSpecific\n        \n        %% Loopbacks\n        SetDefault --&gt; LoopNodes\n        ParseSetSpecific --&gt; LoopNodes\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; LoopNodes\n    \n    EndNode([End NacelleDesigner::initialize Complete&lt;br&gt;Return control to PropulsionDesign::initialize()]):::startEnd\n    LoopNodes --&gt;|No more nodes| EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    LoopNodes -. \&quot;Retrieves node vector via\&quot; .-&gt; Ext1\n    ReadConfig -. \&quot;Reads values via\&quot; .-&gt; Ext1\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VoxeVlmE4uLg4nqVJoxQ-1">
