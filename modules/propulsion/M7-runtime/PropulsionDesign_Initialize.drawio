  <diagram id="t7JAB8zKxnpDxziDubjc" name="io::load_engine_data">
    <mxGraphModel dx="1675" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Data / Value Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;XML Data Parser)]:::io\n        Ext2[(C++ std::filesystem)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start io::load_engine_data()&lt;br/&gt;File: io/engine_xml.h]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;XML File Search &amp; Load Workflow\&quot;]\n        direction TB\n        \n        %% Initialization\n        BuildPath[Build expected file path&lt;br/&gt;&#39;engine_name/engine_name.xml&#39;]:::process\n        \n        %% Loop\n        SearchLoop{For each search_path&lt;br/&gt;in provided paths}:::decision\n        \n        BuildFull[Build full engine_xml_path]:::process\n        CheckExists{Does file exist?}:::decision\n        \n        %% Exists path\n        ParseXML[Parse XML file via aixml::openDocument]:::process\n        InitEngineData[Initialize and return EngineData object]:::process\n        \n        %% Does not exist path\n        AppendLog[Append path to paths_searched string]:::process\n        \n        %% Loop exhausted\n        ThrowError[Throw std::runtime_error&lt;br/&gt;File not found in any search path]:::error\n\n        %% Flow\n        BuildPath --&gt; SearchLoop\n        SearchLoop --&gt;|Next Path| BuildFull\n        BuildFull --&gt; CheckExists\n        \n        CheckExists --&gt;|Yes| ParseXML\n        ParseXML --&gt; InitEngineData\n        \n        CheckExists --&gt;|No| AppendLog\n        AppendLog --&gt; SearchLoop\n        \n        SearchLoop --&gt;|Loop Exhausted| ThrowError\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; BuildPath\n    \n    EndNode([End io::load_engine_data()&lt;br&gt;Return EngineData]):::startEnd\n    InitEngineData --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    CheckExists -. \&quot;Uses std::filesystem::exists\&quot; .-&gt; Ext2\n    ParseXML -. \&quot;Calls openDocument\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YAQZBcy-eZP7mxry_ceN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="YAQZBcy-eZP7mxry_ceN-2">
