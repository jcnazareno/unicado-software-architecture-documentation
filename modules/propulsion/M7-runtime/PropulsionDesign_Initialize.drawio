  <diagram id="D-FVT8oDOwOtlhUHB9lE" name="pylon_designer-&gt;initialize()">
    <mxGraphModel dx="2871" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start pylon_designer-&gt;initialize()&lt;br/&gt;Entry Point from propulsion_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Pylon Initialization Workflow\&quot;]\n        direction TB\n        \n        LoopNodes{For each propulsion node&lt;br/&gt;in configuration XML?}:::decision\n        \n        ReadConfig[\&quot;Read &#39;ID&#39; attribute and&lt;br/&gt;&#39;pylon/profile/value&#39;\&quot;]:::process\n        \n        ToLower[\&quot;Transform strings to lower case&lt;br/&gt;via std::transform\&quot;]:::process\n        \n        CheckID{Is ID == &#39;default&#39;?}:::decision\n        \n        SetDefault[\&quot;Assign shape to default index&lt;br/&gt;this-&gt;section_profiles(-1) = shape\&quot;]:::process\n        \n        ParseSetSpecific[\&quot;Parse ID via std::stoi and assign&lt;br/&gt;this-&gt;section_profiles(engine_id) = shape\&quot;]:::process\n\n        %% Flow\n        LoopNodes --&gt;|Next Node| ReadConfig\n        ReadConfig --&gt; ToLower\n        ToLower --&gt; CheckID\n        \n        CheckID --&gt;|Yes| SetDefault\n        CheckID --&gt;|No| ParseSetSpecific\n        \n        %% Loopbacks\n        SetDefault --&gt; LoopNodes\n        ParseSetSpecific --&gt; LoopNodes\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; LoopNodes\n    \n    EndNode([End PylonDesigner::initialize Complete&lt;br&gt;Return control to PropulsionDesign::initialize()]):::startEnd\n    LoopNodes --&gt;|No more nodes| EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    LoopNodes -. \&quot;Retrieves node vector via\&quot; .-&gt; Ext1\n    ReadConfig -. \&quot;Reads values via\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GnlnwKwNCnFVqi8vsWbF-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="GnlnwKwNCnFVqi8vsWbF-2">
