  <diagram id="zni79EpyV6b6mK4KLoDL" name="engine_designer-&gt;Initialize()">
    <mxGraphModel dx="2010" dy="840" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L6[Subroutine Call]:::subroutine\n        L3[(Data / Information Source)]:::io\n        L4{Decision}:::decision\n        L5[Exception]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES (Data/Values Only)\n    %% ==========================================\n    subgraph Dependencies [\&quot;Data / Value Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;XML Data Extraction)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start Rubber::initialize()&lt;br/&gt;File: engine_design/rubber/rubber_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Rubber Strategy Initialization Workflow\&quot;]\n        direction TB\n        \n        %% Subroutines\n        CallBase[Subroutine: EngineDesigner::initialize()&lt;br/&gt;File: engine_design.cpp]:::subroutine\n        \n        %% Loop Start\n        LoopPropNodes{For each propulsion node&lt;br/&gt;in configuration XML}:::decision\n        \n        %% Node Processing\n        CheckModel{Is engine_model&lt;br/&gt;found?}:::decision\n        \n        GetID[Extract ID and Engine Model]:::process\n        StorePreselected[Store in preselected_engines_ map]:::process\n        \n        CheckDir{Does directory exist&lt;br/&gt;for engine model?}:::decision\n        \n        %% Subroutines for Data Loading\n        LoadEngineData[Subroutine: io::load_engine_data&lt;br/&gt;File: io.cpp]:::subroutine\n        LoadDeckData[Subroutine: DeckData::from_csv&lt;br/&gt;File: deck_data.cpp]:::subroutine\n        \n        GetXMLEff[Read engine_xml_efficiency_factor&lt;br/&gt;from EngineData object]:::process\n        \n        %% Efficiency Logic\n        CheckEffDiff{abs(xml_eff - config_eff)&lt;br/&gt;&gt; 1e-6?}:::decision\n        \n        WarnEff[Log mismatch warning via utility::print]:::process\n        CalcNewEff[Calculate new overall efficiency factor]:::process\n        UpdateEff[Update factor in strategy instance]:::process\n        \n        %% Try Block\n        TrySetEff[Try: set_engine_efficiency_factor(efficiency_factor)&lt;br/&gt;on EngineData]:::process\n        \n        CatchBlock{Exception thrown?}:::decision\n        CatchError[Catch std::exception&lt;br/&gt;Print error &amp; exit(EXIT_FAILURE)]:::error\n        \n        ScaleDeck[Subroutine: EngineDesigner::scale_deck_data_values&lt;br/&gt;File: engine_design.cpp]:::subroutine\n        WriteDeck[Subroutine: EngineDesigner::write_deck_value&lt;br/&gt;File: engine_design.cpp]:::subroutine\n        \n        CheckManip{abs(efficiency_factor - 1.0)&lt;br/&gt;&gt; 1e-6?}:::decision\n        LogManip[Log manipulation info via utility::print]:::process\n\n        %% Flow Map\n        CallBase --&gt; LoopPropNodes\n        LoopPropNodes --&gt;|Next Node| CheckModel\n        \n        CheckModel --&gt;|Yes| GetID\n        GetID --&gt; StorePreselected\n        StorePreselected --&gt; CheckDir\n        \n        CheckDir --&gt;|Yes| LoadEngineData\n        LoadEngineData --&gt; LoadDeckData\n        LoadDeckData --&gt; GetXMLEff\n        GetXMLEff --&gt; CheckEffDiff\n        \n        CheckEffDiff --&gt;|Yes| WarnEff\n        WarnEff --&gt; CalcNewEff\n        CalcNewEff --&gt; UpdateEff\n        UpdateEff --&gt; TrySetEff\n        TrySetEff --&gt; CatchBlock\n        \n        CatchBlock --&gt;|Yes| CatchError\n        CatchBlock --&gt;|No| ScaleDeck\n        \n        ScaleDeck --&gt; WriteDeck\n        WriteDeck --&gt; CheckManip\n        \n        CheckManip --&gt;|Yes| LogManip\n        \n        %% Loopbacks\n        CheckModel --&gt;|No| LoopPropNodes\n        CheckDir --&gt;|No| LoopPropNodes\n        CheckEffDiff --&gt;|No| LoopPropNodes\n        CheckManip --&gt;|No| LoopPropNodes\n        LogManip --&gt; LoopPropNodes\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CallBase\n    \n    EndNode([End Rubber::initialize()&lt;br&gt;Return control to PropulsionDesign::initialize()]):::startEnd\n    LoopPropNodes --&gt;|No more nodes| EndNode\n\n    %% ==========================================\n    %% DATA DEPENDENCY LINKS\n    %% ==========================================\n    LoopPropNodes -. \&quot;Retrieves propulsion node vector via\&quot; .-&gt; Ext1\n    CheckModel -. \&quot;Queries &#39;engine_model&#39; via\&quot; .-&gt; Ext1\n    GetID -. \&quot;Reads &#39;ID&#39; string attributes via\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TqmZwJWRjkBCz4gWpVGh-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
