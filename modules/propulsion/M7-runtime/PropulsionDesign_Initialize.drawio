        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style InitPipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[[Subroutine / Linked Function]]:::subroutine\n        L4[(Dependencies / Libraries)]:::io\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Library)]:::io\n        Ext2[(moduleBasics/module.h&lt;br/&gt;External UNICADO Core API)]:::io\n        Ext3[(C++ Standard Library&lt;br/&gt;string, vector, memory)]:::io\n        Int1[(engine_design, nacelle, pylon, mass&lt;br/&gt;Local Sub-folder Headers)]:::io\n    end\n\n    %% ==========================================\n    %% SYSTEM ENTRY\n    %% ==========================================\n    Entry([Start initialize()&lt;br&gt;Invoked by Module Pipeline]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph InitPipeline [\&quot;propulsion_design::initialize() Workflow\&quot;]\n        direction TB\n        \n        %% Standard Variables &amp; IO Setup\n        IO_Setup[Read XML Resources&lt;br&gt;Fetches paths via get_RuntimeIO&lt;br&gt;Opens files via aixml]:::process\n        Var_Setup[Set reference_offset = 0,0,0]:::process\n        \n        %% Primary internal functions\n        Sub1[[create_aircraft_geometry()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub2[[create_propulsors()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub3[[sort_propulsors()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub4[[check_validity()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        \n        %% Strategy Selectors\n        Sub5[[select_engine_designer()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub6[[select_propulsion_integrator()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub7[[select_nacelle_designer()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub8[[select_pylon_designer()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub9[[select_mass_analyzer()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        \n        %% Strategy Initialization (External delegation)\n        Sub10[[engine_designer-&gt;initialize()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub11[[propulsion_integrator-&gt;initialize()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub12[[nacelle_designer-&gt;initialize()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub13[[pylon_designer-&gt;initialize()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n        Sub14[[mass_analyzer-&gt;initialize()&lt;br&gt;(Click for detailed diagram)]]:::subroutine\n\n        %% Connections\n        IO_Setup --&gt; Var_Setup\n        Var_Setup --&gt; Sub1\n        Sub1 --&gt; Sub2\n        Sub2 --&gt; Sub3\n        Sub3 --&gt; Sub4\n        Sub4 --&gt; Sub5\n        Sub5 --&gt; Sub6\n        Sub6 --&gt; Sub7\n        Sub7 --&gt; Sub8\n        Sub8 --&gt; Sub9\n        Sub9 --&gt; Sub10\n        Sub10 --&gt; Sub11\n        Sub11 --&gt; Sub12\n        Sub12 --&gt; Sub13\n        Sub13 --&gt; Sub14\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; IO_Setup\n    \n    EndNode([End initialize()&lt;br&gt;Proceed to Phase 2: run()]):::startEnd\n    Sub14 --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    IO_Setup -. \&quot;Calls\&quot; .-&gt; Ext1\n    IO_Setup -. \&quot;Uses\&quot; .-&gt; Ext2\n    \n    Sub5 -. \&quot;Instantiates via\&quot; .-&gt; Int1\n    Sub6 -. \&quot;Instantiates via\&quot; .-&gt; Int1\n    Sub7 -. \&quot;Instantiates via\&quot; .-&gt; Int1\n    Sub8 -. \&quot;Instantiates via\&quot; .-&gt; Int1\n    Sub9 -. \&quot;Instantiates via\&quot; .-&gt; Int1\n    \n    Sub10 -. \&quot;Invokes method in\&quot; .-&gt; Int1\n    Sub11 -. \&quot;Invokes method in\&quot; .-&gt; Int1\n    Sub12 -. \&quot;Invokes method in\&quot; .-&gt; Int1\n    Sub13 -. \&quot;Invokes method in\&quot; .-&gt; Int1\n    Sub14 -. \&quot;Invokes method in\&quot; .-&gt; Int1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fJmmkj9e3beQ91FbUIf3-1">
