        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Method Check}:::decision\n        L5[Exception Thrown]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n        Ext3[(C++ Standard Library&lt;br/&gt;memory, string, stdexcept)]:::io\n        Int1[(mass/default/default_mass.h&lt;br/&gt;Local Strategy Class)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start select_mass_analyzer()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Strategy Selection Workflow\&quot;]\n        direction TB\n        \n        %% Step 1: Read Config\n        ReadConfig[Read mass_analyzer method string from&lt;br/&gt;configuration_xml nodes]:::process\n        \n        %% Step 2: Decision\n        CheckMethod{Is method == &#39;Default&#39;?}:::decision\n        \n        %% True Path\n        InstantiateDefault[Instantiate Default strategy via std::make_unique&lt;br/&gt;Pass XML]:::process\n        LogSuccess[Log selection via utility::print]:::process\n        \n        %% False Path\n        ThrowError[Throw std::runtime_error&lt;br/&gt;&#39;Mass analyzer method is not supported&#39;]:::error\n\n        %% Flow Map\n        ReadConfig --&gt; CheckMethod\n        \n        CheckMethod --&gt;|Yes| InstantiateDefault\n        CheckMethod --&gt;|No| ThrowError\n        \n        InstantiateDefault --&gt; LogSuccess\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ReadConfig\n    \n    EndNode([End select_mass_analyzer()&lt;br&gt;Strategy Object Stored in memory]):::startEnd\n    LogSuccess --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    ReadConfig -. \&quot;Reads via\&quot; .-&gt; Ext1\n    \n    InstantiateDefault -. \&quot;Uses std::make_unique\&quot; .-&gt; Ext3\n    InstantiateDefault -. \&quot;Instantiates\&quot; .-&gt; Int1\n    \n    ThrowError -. \&quot;Uses std::runtime_error\&quot; .-&gt; Ext3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ORt22_hzECr_p4fu8u8m-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
