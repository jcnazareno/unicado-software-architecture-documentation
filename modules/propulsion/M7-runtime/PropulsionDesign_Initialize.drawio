  <diagram id="GYDrAxwwPuQ9Iw6CKtva" name="select_engine_designer()">
    <mxGraphModel dx="1655" dy="643" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style GetDesignCondition fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Method Check}:::decision\n        L5[Exception Thrown]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n        Ext2[(moduleBasics/module.h&lt;br/&gt;External UNICADO Core API)]:::io\n        Ext3[(C++ Standard Library&lt;br/&gt;memory, string, stdexcept)]:::io\n        Int1[(engine_design/rubber/rubber_design.h&lt;br/&gt;Local Strategy Class)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start select_engine_designer()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Strategy Selection Workflow\&quot;]\n        direction TB\n        \n        %% Step 1: Flight Conditions\n        subgraph GetDesignCondition [\&quot;Method inside file: get_design_condition()\&quot;]\n            direction TB\n            ReadMachAlt[Read Mach, Altitude, ISA&lt;br/&gt;via EndnodeReadOnly]:::process\n            CreateAtm[Create atmosphere object&lt;br/&gt;Apply ISA offset]:::process\n            ReturnFC[Return FlightCondition struct]:::process\n            \n            ReadMachAlt --&gt; CreateAtm\n            CreateAtm --&gt; ReturnFC\n        end\n        \n        %% Step 2: Read Config\n        ReadConfig[Read designer method string from&lt;br/&gt;configuration_xml nodes]:::process\n        \n        %% Step 3: Decision\n        CheckMethod{Is method == &#39;Rubber&#39;?}:::decision\n        \n        %% True Path\n        InstantiateRubber[Instantiate Rubber strategy via std::make_unique&lt;br/&gt;Pass XML, EngineDataDir, and FlightCondition]:::process\n        LogSuccess[Log selection via utility::print]:::process\n        \n        %% False Path\n        ThrowError[Throw std::runtime_error&lt;br/&gt;&#39;Engine designer method is not supported&#39;]:::error\n\n        %% Flow Connections\n        ReturnFC --&gt; ReadConfig\n        ReadConfig --&gt; CheckMethod\n        \n        CheckMethod --&gt;|Yes| InstantiateRubber\n        CheckMethod --&gt;|No| ThrowError\n        \n        InstantiateRubber --&gt; LogSuccess\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ReadMachAlt\n    \n    EndNode([End select_engine_designer()&lt;br&gt;Engine Designer Strategy set]):::startEnd\n    LogSuccess --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    ReadMachAlt -. \&quot;Reads via\&quot; .-&gt; Ext1\n    ReadConfig -. \&quot;Reads via\&quot; .-&gt; Ext1\n    \n    InstantiateRubber -. \&quot;Uses getEngineDataDir()\&quot; .-&gt; Ext2\n    InstantiateRubber -. \&quot;Uses std::make_unique\&quot; .-&gt; Ext3\n    InstantiateRubber -. \&quot;Instantiates\&quot; .-&gt; Int1\n    \n    ThrowError -. \&quot;Uses std::runtime_error\&quot; .-&gt; Ext3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0pghs4QfXmU__FVkcurC-1">
