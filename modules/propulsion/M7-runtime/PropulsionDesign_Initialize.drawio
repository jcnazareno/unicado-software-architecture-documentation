  <diagram id="Gi20NhwJngdgWBqXWFUs" name="mass_analyzer::intialize()">
    <mxGraphModel dx="2263" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start mass_analyzer-&gt;initialize()&lt;br/&gt;Entry Point from propulsion_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Mass Analyzer Initialization Workflow\&quot;]\n        direction TB\n        \n        LoadEngineMass[\&quot;Call: configuration-&gt;at&lt;br/&gt;this-&gt;technology_factors(&#39;engine_mass&#39;) = value\&quot;]:::process\n        \n        LoadNacelleMass[\&quot;Call: configuration-&gt;at&lt;br/&gt;this-&gt;technology_factors(&#39;nacelle_mass&#39;) = value\&quot;]:::process\n        \n        LoadPylonMass[\&quot;Call: configuration-&gt;at&lt;br/&gt;this-&gt;technology_factors(&#39;pylon_mass&#39;) = value\&quot;]:::process\n\n        %% Flow\n        LoadEngineMass --&gt; LoadNacelleMass\n        LoadNacelleMass --&gt; LoadPylonMass\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; LoadEngineMass\n    \n    EndNode([End MassAnalyzer::initialize Complete&lt;br&gt;Return control to PropulsionDesign::initialize()]):::startEnd\n    LoadPylonMass --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    LoadEngineMass -. \&quot;Reads values via\&quot; .-&gt; Ext1\n    LoadNacelleMass -. \&quot;Reads values via\&quot; .-&gt; Ext1\n    LoadPylonMass -. \&quot;Reads values via\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CU9vsTG41GHwqIvTQgf--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="CU9vsTG41GHwqIvTQgf--2">
