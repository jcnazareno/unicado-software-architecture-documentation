  <diagram id="uC3z0hOaToSHazdCS-34" name="check_validity()">
    <mxGraphModel dx="1915" dy="965" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Validation Check}:::decision\n        L5[Exception Thrown]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n        Ext2[(C++ Standard Library&lt;br/&gt;stdexcept, variant, cmath)]:::io\n        Ext3[(unitConversion/constants.h&lt;br/&gt;External UNICADO Constants)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start check_validity()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;propulsion_design::check_validity() Workflow\&quot;]\n        direction TB\n        \n        %% Initialization\n        ReadXML[Read MTOM &amp; thrust_to_weight&lt;br/&gt;from XML nodes]:::process\n        CalcReqThrust[Calculate total_thrust_required&lt;br/&gt;total = G_FORCE * MTOM * T/W]:::process\n        \n        %% Engine loop\n        InitAccumulators[Initialize Accumulators&lt;br/&gt;total_thrust_actual = 0&lt;br/&gt;total_moment = 0]:::process\n        LoopEngines[Iterate through this-&gt;engines&lt;br/&gt;std::visit]:::process\n        Accumulate[Accumulate values:&lt;br/&gt;+ engine.required_thrust()&lt;br/&gt;+ (thrust * engine.position().y())]:::process\n        \n        %% Validation gates\n        CheckTW{thrust_to_weight &lt;= 0?}:::decision\n        CheckMTOM{MTOM &lt;= 0?}:::decision\n        CheckThrustSum{abs(actual - required)&lt;br/&gt;&gt;= 10.0 N?}:::decision\n        CheckMoment{abs(total_moment)&lt;br/&gt;&gt;= 10.0 Nm?}:::decision\n        \n        %% Error Nodes\n        ErrTW[Throw std::runtime_error&lt;br/&gt;&#39;No design thrust given&#39;]:::error\n        ErrMTOM[Throw std::runtime_error&lt;br/&gt;&#39;No MTOM given&#39;]:::error\n        ErrThrust[Throw std::runtime_error&lt;br/&gt;&#39;Total thrust share != 1&#39;]:::error\n        ErrMoment[Throw std::runtime_error&lt;br/&gt;&#39;Non-symmetrical thrust&#39;]:::error\n\n        %% Flow Map\n        ReadXML --&gt; CalcReqThrust\n        CalcReqThrust --&gt; InitAccumulators\n        InitAccumulators --&gt; LoopEngines\n        LoopEngines --&gt; Accumulate\n        Accumulate --&gt; CheckTW\n        \n        CheckTW --&gt;|Yes| ErrTW\n        CheckTW --&gt;|No| CheckMTOM\n        \n        CheckMTOM --&gt;|Yes| ErrMTOM\n        CheckMTOM --&gt;|No| CheckThrustSum\n        \n        CheckThrustSum --&gt;|Yes| ErrThrust\n        CheckThrustSum --&gt;|No| CheckMoment\n        \n        CheckMoment --&gt;|Yes| ErrMoment\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ReadXML\n    \n    EndNode([End check_validity()&lt;br&gt;Validity verified, return to pipeline]):::startEnd\n    CheckMoment --&gt;|No| EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    ReadXML -. \&quot;Reads via\&quot; .-&gt; Ext1\n    CalcReqThrust -. \&quot;References G_FORCE from\&quot; .-&gt; Ext3\n    \n    LoopEngines -. \&quot;Uses std::visit\&quot; .-&gt; Ext2\n    CheckThrustSum -. \&quot;Uses std::abs\&quot; .-&gt; Ext2\n    CheckMoment -. \&quot;Uses std::abs\&quot; .-&gt; Ext2\n    \n    ErrTW -. \&quot;Uses std::runtime_error\&quot; .-&gt; Ext2\n    ErrMTOM -. \&quot;Uses std::runtime_error\&quot; .-&gt; Ext2\n    ErrThrust -. \&quot;Uses std::runtime_error\&quot; .-&gt; Ext2\n    ErrMoment -. \&quot;Uses std::runtime_error\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="juhHkbMx3otLVlOpj6rS-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
