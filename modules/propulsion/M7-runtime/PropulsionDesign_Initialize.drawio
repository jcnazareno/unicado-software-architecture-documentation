  <diagram id="--H5TB75KAl0u72YHDVy" name="utility::create_energy_carrier_map">
    <mxGraphModel dx="2553" dy="1287" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ToEnergyCarrier fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision / Loop}:::decision\n        L5[Exception Thrown]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Data / Value Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;XML Data Extraction)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start utility::create_energy_carrier_map()&lt;br/&gt;File: src/utility.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Energy Carrier Mapping Workflow\&quot;]\n        direction TB\n        \n        %% Setup\n        InitMap[Initialize empty EnergyCarriersMap]:::process\n        GetNodes[Extract vector of &#39;energy_carrier&#39; nodes]:::process\n        \n        %% Loop\n        LoopNodes{For each energy&lt;br/&gt;carrier node?}:::decision\n        \n        %% Inside Loop\n        GetID[Extract &#39;ID&#39; integer attribute]:::process\n        GetValue[Extract &#39;value&#39; string]:::process\n        ConvertToEnum[Call utility::to_energy_carrier]:::process\n        InsertMap[Insert ID and enum into map]:::process\n        \n        %% Flow Connections\n        InitMap --&gt; GetNodes\n        GetNodes --&gt; LoopNodes\n        \n        LoopNodes --&gt;|Next Node| GetID\n        GetID --&gt; GetValue\n        GetValue --&gt; ConvertToEnum\n        ConvertToEnum --&gt; InsertMap\n        InsertMap --&gt; LoopNodes\n    end\n\n    %% ==========================================\n    %% DETAILED INTERNAL METHODS\n    %% ==========================================\n    subgraph ToEnergyCarrier [\&quot;Method inside file: utility::to_energy_carrier\&quot;]\n        direction TB\n        Normalize[Normalize string to lowercase&lt;br/&gt;via std::transform(::tolower)]:::process\n        CheckType{String Match?}:::decision\n        \n        SetKero[Return EnergyCarrier::Kerosene]:::process\n        SetH2[Return EnergyCarrier::Liquid_Hydrogen]:::process\n        ThrowError[Throw std::runtime_error&lt;br/&gt;&#39;Energy carrier is not supported&#39;]:::error\n        \n        Normalize --&gt; CheckType\n        CheckType --&gt;|&#39;kerosene&#39;| SetKero\n        CheckType --&gt;|&#39;liquid_hydrogen&#39;| SetH2\n        CheckType --&gt;|Other| ThrowError\n    end\n    \n    ConvertToEnum -. \&quot;Exploded View\&quot; .- ToEnergyCarrier\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; InitMap\n    \n    EndNode([End function&lt;br&gt;Return populated map to create_propulsors()]):::startEnd\n    LoopNodes --&gt;|No more nodes| EndNode\n\n    %% ==========================================\n    %% DATA DEPENDENCY LINKS\n    %% ==========================================\n    GetNodes -. \&quot;Retrieves node vector via\&quot; .-&gt; Ext1\n    GetID -. \&quot;Reads &#39;ID&#39; via\&quot; .-&gt; Ext1\n    GetValue -. \&quot;Reads &#39;value&#39; via\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R9oLcexwJUbitCWwj5b2-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
