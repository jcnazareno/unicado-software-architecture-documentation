        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style GetParentComponent fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception Thrown]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Data / Value Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;XML Data Extraction)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start utility::create_engine()&lt;br/&gt;File: src/utility.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Engine Instantiation Workflow\&quot;]\n        direction TB\n        \n        %% Step 1: Base XML Extraction\n        ExtractType[Extract &#39;powertrain&#39; and &#39;type&#39; strings]:::process\n        ExtractEnergyID[Extract &#39;energy_carrier_ID&#39;]:::process\n        \n        %% Step 2: Energy Carrier Lookup\n        CheckMap{Is ID found in&lt;br/&gt;EnergyCarriersMap?}:::decision\n        MapError[Throw std::runtime_error&lt;br/&gt;&#39;Energy carrier ID not found&#39;]:::error\n        GetEnum[Retrieve EnergyCarrier Enum from map]:::process\n        \n        %% Step 3: Thrust and Offtakes\n        ExtractThrust[Extract &#39;thrust_share&#39; value]:::process\n        CalcThrust[Calculate design_thrust&lt;br/&gt;total_installed_thrust * thrust_share]:::process\n        CalcOfftakes[Calculate engine_offtakes&lt;br/&gt;thrust_share * total_offtakes_required]:::process\n        \n        %% Step 4: ID and Position\n        ExtractID[Extract &#39;ID&#39; integer]:::process\n        ExtractPosition[Extract &#39;position&#39; node]:::process\n        \n        %% Inlined Helper\n        subgraph GetParentComponent [\&quot;Method inside file: utility::get_parent_component\&quot;]\n            direction TB\n            MapStrings[Map parent_component, x, y, and z strings&lt;br/&gt;to Enums (e.g. Lateral::Left, Vertical::Under)]:::process\n            ReturnPosition[Return populated ParentComponent struct]:::process\n            \n            MapStrings --&gt; ReturnPosition\n        end\n        \n        %% Step 5: Engine Factory Switch\n        SwitchType{Check concatenated type:&lt;br/&gt;(power_type + thrust_type)}:::decision\n        \n        %% Turbofan Branch\n        CheckEnergyTF{Turbofan:&lt;br/&gt;Which EnergyCarrier?}:::decision\n        ReturnTFKero[Return Turbofan&lt;Kerosene&gt;]:::process\n        ReturnTFH2[Return Turbofan&lt;Liquid_Hydrogen&gt;]:::process\n        \n        %% Turboprop Branch\n        CheckEnergyTP{Turboprop:&lt;br/&gt;Which EnergyCarrier?}:::decision\n        ReturnTPKero[Return Turboprop&lt;Kerosene&gt;]:::process\n        ReturnTPH2[Return Turboprop&lt;Liquid_Hydrogen&gt;]:::process\n        \n        %% Openrotorfan Branch\n        CheckEnergyORF{Openrotorfan:&lt;br/&gt;Which EnergyCarrier?}:::decision\n        ReturnORFKero[Return Openrotorfan&lt;Kerosene&gt;]:::process\n        \n        %% Exceptions\n        ThrowEnergy[Throw std::runtime_error&lt;br/&gt;&#39;Energy carrier not supported&#39;]:::error\n        ThrowType[Throw std::runtime_error&lt;br/&gt;&#39;Powertrain is not supported&#39;]:::error\n        \n        %% Flow Connections\n        ExtractType --&gt; ExtractEnergyID\n        ExtractEnergyID --&gt; CheckMap\n        CheckMap --&gt;|No| MapError\n        CheckMap --&gt;|Yes| GetEnum\n        \n        GetEnum --&gt; ExtractThrust\n        ExtractThrust --&gt; CalcThrust\n        CalcThrust --&gt; CalcOfftakes\n        CalcOfftakes --&gt; ExtractID\n        ExtractID --&gt; ExtractPosition\n        ExtractPosition --&gt; MapStrings\n        \n        ReturnPosition --&gt; SwitchType\n        \n        SwitchType --&gt;|&#39;turbofan&#39;| CheckEnergyTF\n        CheckEnergyTF --&gt;|Kerosene| ReturnTFKero\n        CheckEnergyTF --&gt;|Liquid_Hydrogen| ReturnTFH2\n        CheckEnergyTF --&gt;|Other| ThrowEnergy\n        \n        SwitchType --&gt;|&#39;turboprop&#39;| CheckEnergyTP\n        CheckEnergyTP --&gt;|Kerosene| ReturnTPKero\n        CheckEnergyTP --&gt;|Liquid_Hydrogen| ReturnTPH2\n        CheckEnergyTP --&gt;|Other| ThrowEnergy\n        \n        SwitchType --&gt;|&#39;openrotorfan&#39;| CheckEnergyORF\n        CheckEnergyORF --&gt;|Kerosene| ReturnORFKero\n        CheckEnergyORF --&gt;|Other| ThrowEnergy\n        \n        SwitchType --&gt;|Other| ThrowType\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ExtractType\n    \n    EndNode([End function&lt;br&gt;Return Engine Object via std::variant]):::startEnd\n    ReturnTFKero --&gt; EndNode\n    ReturnTFH2 --&gt; EndNode\n    ReturnTPKero --&gt; EndNode\n    ReturnTPH2 --&gt; EndNode\n    ReturnORFKero --&gt; EndNode\n\n    %% ==========================================\n    %% DATA DEPENDENCY LINKS\n    %% ==========================================\n    ExtractType -. \&quot;Reads strings via\&quot; .-&gt; Ext1\n    ExtractEnergyID -. \&quot;Reads int via\&quot; .-&gt; Ext1\n    ExtractThrust -. \&quot;Reads double via\&quot; .-&gt; Ext1\n    ExtractID -. \&quot;Reads attrib via\&quot; .-&gt; Ext1\n    ExtractPosition -. \&quot;Extracts node via\&quot; .-&gt; Ext1\n    MapStrings -. \&quot;Reads strings via\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UCO8yhlfombUBAVluYQ1-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2601" width="2287" as="geometry" />
          </mxCell>
