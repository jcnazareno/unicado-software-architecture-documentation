  <diagram id="xBK0Uk2VTACbQrCggoCI" name="create_propulsors()">
    <mxGraphModel dx="4525" dy="1103" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L6[Subroutine Call]:::subroutine\n        L3[(Data / Libraries)]:::io\n        L4{Decision / Condition}:::decision\n        L5[Error / Alternative Path]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n        Ext2[(C++ Standard Library&lt;br/&gt;algorithm, string, format)]:::io\n        Ext3[(unitConversion/constants.h&lt;br/&gt;External UNICADO Constants)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start create_propulsors()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;propulsion_design::create_propulsors() Workflow\&quot;]\n        direction TB\n        \n        %% Step 1: Energy Carriers\n        ExtractProps[Extract propulsors vector from XML]:::process\n        ExtractEnergy[Extract energy_carriers node from XML]:::process\n        CreateMap[Subroutine: utility::create_energy_carrier_map]:::subroutine\n        \n        %% Step 2: Thrust Calcs\n        ExtractMass[Read MTOM and thrust_to_weight from XML]:::process\n        CalcThrust[Calculate total_thrust_required&lt;br/&gt;total = G_FORCE * MTOM * T/W]:::process\n        LogThrust[Log calculation via utility::print]:::process\n        \n        %% Step 3: Offtakes Check\n        CheckOfftakes[Initialize empty Offtakes struct&lt;br/&gt;Search XML for bleed_air and power_demand]:::process\n        \n        DecisionOfftakes{Were offtakes&lt;br/&gt;found in XML?}:::decision\n        \n        ReadOfftakes[Read bleed_air and shaft_power&lt;br/&gt;Populate Offtakes struct]:::process\n        WarnOfftakes[Print warning via utility::print&lt;br/&gt;&#39;Using default values&#39;]:::error\n        \n        %% Step 4: Instantiation\n        LoopEngines[For each propulsor in vector&lt;br/&gt;std::for_each lambda]:::process\n        InstantiateEngine[Subroutine: utility::create_engine]:::subroutine\n        AddEngine[Add to this-&gt;engines list&lt;br/&gt;this-&gt;engines.emplace_back]:::process\n\n        %% Connections\n        ExtractProps --&gt; ExtractEnergy\n        ExtractEnergy --&gt; CreateMap\n        CreateMap --&gt; ExtractMass\n        ExtractMass --&gt; CalcThrust\n        CalcThrust --&gt; LogThrust\n        LogThrust --&gt; CheckOfftakes\n        CheckOfftakes --&gt; DecisionOfftakes\n        \n        DecisionOfftakes --&gt;|Yes| ReadOfftakes\n        DecisionOfftakes --&gt;|No| WarnOfftakes\n        \n        ReadOfftakes --&gt; LoopEngines\n        WarnOfftakes --&gt; LoopEngines\n        \n        LoopEngines --&gt; InstantiateEngine\n        InstantiateEngine --&gt; AddEngine\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; ExtractProps\n    \n    EndNode([End create_propulsors()&lt;br&gt;Return to initialize() pipeline]):::startEnd\n    \n    AddEngine --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    ExtractProps -. \&quot;Reads via\&quot; .-&gt; Ext1\n    ExtractEnergy -. \&quot;Reads via\&quot; .-&gt; Ext1\n    ExtractMass -. \&quot;Reads via\&quot; .-&gt; Ext1\n    CheckOfftakes -. \&quot;Reads via\&quot; .-&gt; Ext1\n    ReadOfftakes -. \&quot;Reads via\&quot; .-&gt; Ext1\n    \n    CalcThrust -. \&quot;References G_FORCE from\&quot; .-&gt; Ext3\n    \n    LoopEngines -. \&quot;Uses std::for_each\&quot; .-&gt; Ext2\n    LogThrust -. \&quot;Uses std::format\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9_MORxdmDysEvcXNHHRO-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2416" as="geometry" />
          </mxCell>
        </UserObject>
