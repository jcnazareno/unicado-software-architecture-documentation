  <diagram id="KcHLDSlqqjZ01YInKCwx" name="EngineDesigner::scale_deck_data_values">
    <mxGraphModel dx="2263" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L4{Decision}:::decision\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start EngineDesigner::scale_deck_data_values()&lt;br/&gt;File: engine_design/engine_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;Deck Scaling Workflow\&quot;]\n        direction TB\n        \n        %% Pre-calculation\n        CalcTechFactor[Calculate technology_factor:&lt;br/&gt;1 + (1 - efficiency_factor)]:::process\n        \n        %% Loops\n        LoopI{For i in shape 0}:::decision\n        LoopJ{For j in shape 1}:::decision\n        LoopK{For k in shape 2}:::decision\n        \n        %% Value Check\n        CheckVal{Is value[i][j][k] != -9999?}:::decision\n        ApplyFactor[Multiply value by technology_factor]:::process\n\n        %% Flow\n        CalcTechFactor --&gt; LoopI\n        LoopI --&gt;|Next| LoopJ\n        LoopJ --&gt;|Next| LoopK\n        \n        LoopK --&gt;|Next| CheckVal\n        CheckVal --&gt;|Yes| ApplyFactor\n        \n        %% Loopbacks\n        CheckVal --&gt;|No| LoopK\n        ApplyFactor --&gt; LoopK\n        \n        LoopK --&gt;|Complete| LoopJ\n        LoopJ --&gt;|Complete| LoopI\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CalcTechFactor\n    \n    EndNode([End EngineDesigner::scale_deck_data_values()&lt;br&gt;Return scaled DeckData]):::startEnd\n    LoopI --&gt;|Complete| EndNode&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vw_3TeyhqHwzuHOVQAK4-1">
