  <diagram id="Dd7x9WKuuv-XAVZydAaz" name="EngineDesigner::write_deck_value">
    <mxGraphModel dx="1182" dy="494" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Data / Value Dependencies\&quot;]\n        direction TB\n        Ext1[(C++ std::ofstream)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start EngineDesigner::write_deck_value()&lt;br/&gt;File: engine_design/engine_design.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;CSV File Export Workflow\&quot;]\n        direction TB\n        \n        %% Setup\n        BuildPath[Construct target file path:&lt;br/&gt;engine_directory / name / (name + .csv)]:::process\n        OpenFile[Open std::ofstream in truncation mode]:::process\n        \n        %% Caching\n        CacheMach[Cache Mach row via stringstream&lt;br/&gt;Loop over Mach vector]:::process\n        \n        %% Nested Loops\n        LoopN{For each index_N&lt;br/&gt;in data.N}:::decision\n        PrintNMach[Print N value and cached Mach row]:::process\n        \n        LoopFL{For each index_FL&lt;br/&gt;in data.FL}:::decision\n        PrintFLValues[Print FL value&lt;br/&gt;Loop to print all data row values]:::process\n        \n        CloseFile[Close the std::ofstream file]:::process\n\n        %% Flow\n        BuildPath --&gt; OpenFile\n        OpenFile --&gt; CacheMach\n        CacheMach --&gt; LoopN\n        \n        LoopN --&gt;|Next N| PrintNMach\n        PrintNMach --&gt; LoopFL\n        \n        LoopFL --&gt;|Next FL| PrintFLValues\n        \n        %% Loopbacks\n        PrintFLValues --&gt; LoopFL\n        LoopFL --&gt;|Complete| LoopN\n        \n        LoopN --&gt;|Complete| CloseFile\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; BuildPath\n    \n    EndNode([End EngineDesigner::write_deck_value()&lt;br&gt;File saved to disk]):::startEnd\n    CloseFile --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    OpenFile -. \&quot;Uses\&quot; .-&gt; Ext1\n    PrintNMach -. \&quot;Writes to\&quot; .-&gt; Ext1\n    PrintFLValues -. \&quot;Writes to\&quot; .-&gt; Ext1\n    CloseFile -. \&quot;Closes\&quot; .-&gt; Ext1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TFJPEwRxjWEGG2Miu0Ft-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diagram Legend" mermaidId="n:Legend" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Diagram Legend" id="TFJPEwRxjWEGG2Miu0Ft-2">
          <mxCell parent="TFJPEwRxjWEGG2Miu0Ft-1" style="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=#F9F9F9;strokeColor=#CCCCCC;fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="485" width="270" x="78" y="246" as="geometry" />
