  <diagram id="EcaBjSFTdPyn8ssLBMom" name="create_geometry()">
    <mxGraphModel dx="2513" dy="965" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style TryCatchBlock fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision / Condition}:::decision\n        L5[Error / Alternative Path]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(aixml/node.h&lt;br/&gt;External XML Parser)]:::io\n        Ext2[(aircraftGeometry2/geometry/surface.h&lt;br/&gt;External Surface Builders)]:::io\n        Ext3[(C++ Standard Library&lt;br/&gt;string, transform, memory)]:::io\n        Int1[(aircraft_geometry.h&lt;br/&gt;Local struct storing&lt;br/&gt;external geom2 surfaces)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start create_aircraft_geometry()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION LOGIC\n    %% ==========================================\n    DefineLambda[Define get_position lambda&lt;br&gt;Extracts x, y, z from XML node]:::process\n    \n    Entry --&gt; DefineLambda\n    \n    subgraph TryCatchBlock [\&quot;Try-Catch Logic Wrapper\&quot;]\n        direction TB\n        \n        %% Try Block execution\n        QueryXML[Query XML for parts &amp; positions&lt;br&gt;Wings, Fuselages, Empennage]:::process\n        InitFactories[Initialize Surface Builders&lt;br&gt;WingFactory, FuselageFactory, AirfoilFactory]:::process\n        AllocStruct[Allocate aircraft_geometry&lt;br&gt;std::make_shared&lt;geometry::Aircraft&gt;]:::process\n        BuildGeo[Build Geometry Elements via Factories&lt;br&gt;Transforms XML strings into components]:::process\n        ConvertCoords[Convert origins to global coordinates&lt;br&gt;Applies positional offsets against CGAL::ORIGIN]:::process\n        \n        QueryXML --&gt; InitFactories\n        InitFactories --&gt; AllocStruct\n        AllocStruct --&gt; BuildGeo\n        BuildGeo --&gt; ConvertCoords\n    end\n\n    DefineLambda --&gt; TryCatchBlock\n\n    %% ==========================================\n    %% EXCEPTION HANDLING\n    %% ==========================================\n    ErrorCheck{Exception Thrown?&lt;br&gt;e.g. Empty XML / Missing Node}:::decision\n    \n    ConvertCoords --&gt; ErrorCheck\n    \n    SuccessPath[Geometry built successfully]:::process\n    \n    CatchError[Catch std::string Exception]:::error\n    WarnUser[Print warning via utility::print&lt;br/&gt;&#39;No aircraft geometry available&#39;]:::error\n    SetNull[Set aircraft_geometry = nullptr]:::error\n    \n    ErrorCheck --&gt;|No| SuccessPath\n    ErrorCheck --&gt;|Yes| CatchError\n    \n    CatchError --&gt; WarnUser\n    WarnUser --&gt; SetNull\n    \n    %% ==========================================\n    %% EXIT\n    %% ==========================================\n    ExitNode([End function&lt;br&gt;Return to initialize() pipeline]):::startEnd\n    \n    SuccessPath --&gt; ExitNode\n    SetNull --&gt; ExitNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    QueryXML -. \&quot;Reads from\&quot; .-&gt; Ext1\n    InitFactories -. \&quot;Uses\&quot; .-&gt; Ext2\n    AllocStruct -. \&quot;Instantiates via std::make_shared\&quot; .-&gt; Ext3\n    AllocStruct -. \&quot;Instantiates\&quot; .-&gt; Int1\n    BuildGeo -. \&quot;Uses std::transform\&quot; .-&gt; Ext3\n    ConvertCoords -. \&quot;References CGAL::ORIGIN\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="61QO1nz7dDtk4xiAwQkL-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
