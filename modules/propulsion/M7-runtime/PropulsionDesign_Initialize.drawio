  <diagram id="HhughaZt__hLqIBPs3TY" name="DeckData::from_csv">
    <mxGraphModel dx="2010" dy="840" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Data / Value Dependencies\&quot;]\n        direction TB\n        Ext1[(C++ std::ifstream)]:::io\n        Ext2[(parser/csv.h&lt;br/&gt;Custom Deck Parser)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start DeckData::from_csv()&lt;br/&gt;File: libraries/engine/src/parser/csv.cpp]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;CSV File Parsing Workflow\&quot;]\n        direction TB\n        \n        %% Initial Checks\n        CheckExt{Is file extension&lt;br/&gt;== &#39;.csv&#39;?}:::decision\n        ThrowExtError[Throw std::runtime_error&lt;br/&gt;Not a CSV file]:::error\n        \n        OpenFile[Open std::ifstream in binary mode&lt;br/&gt;Disable sync_with_stdio for performance]:::process\n        \n        CheckOpen{Is file open?}:::decision\n        ThrowOpenError[Throw std::runtime_error&lt;br/&gt;Could not open file]:::error\n        \n        %% Parsing Setup\n        InitIterators[Initialize std::istream_iterator&lt;br/&gt;Initialize custom Parser with delimiter]:::process\n        \n        %% Main Parsing\n        ParseFirst[Parse first row for Mach vector&lt;br/&gt;and initial N value]:::process\n        LoopRows[Iterate remaining lines&lt;br/&gt;Tokenize and extract N, FL, Mach values]:::process\n        \n        Assemble[Assemble parsed data into DeckData object]:::process\n\n        %% Flow\n        CheckExt --&gt;|Yes| OpenFile\n        CheckExt --&gt;|No| ThrowExtError\n        \n        OpenFile --&gt; CheckOpen\n        CheckOpen --&gt;|Yes| InitIterators\n        CheckOpen --&gt;|No| ThrowOpenError\n        \n        InitIterators --&gt; ParseFirst\n        ParseFirst --&gt; LoopRows\n        LoopRows --&gt; Assemble\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; CheckExt\n    \n    EndNode([End DeckData::from_csv()&lt;br&gt;Return DeckData]):::startEnd\n    Assemble --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    OpenFile -. \&quot;Uses\&quot; .-&gt; Ext1\n    InitIterators -. \&quot;Instantiates Parser\&quot; .-&gt; Ext2\n    LoopRows -. \&quot;Calls parser.get_row()\&quot; .-&gt; Ext2&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yZB_SeFaFKEm6iiUkvId-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
