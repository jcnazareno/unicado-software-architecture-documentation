  <diagram id="s6hsziIoARt4S7RaMW4G" name="sort_propulsors()">
    <mxGraphModel dx="3350" dy="1287" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style SortLogic fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision / Condition}:::decision\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(C++ Standard Library&lt;br/&gt;algorithm, numeric, variant, utility)]:::io\n        Int1[(propulsion.h&lt;br/&gt;Local Header for Parent &amp; Lateral Enums)]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start sort_propulsors()]):::startEnd\n\n    %% ==========================================\n    %% EXECUTION PIPELINE\n    %% ==========================================\n    subgraph Pipeline [\&quot;propulsion_design::sort_propulsors() Workflow\&quot;]\n        direction TB\n        \n        %% Step 1: Initialization\n        InitVector[Create index vector &#39;v&#39;&lt;br/&gt;Populate sequentially via std::iota]:::process\n        \n        %% Step 2: Counting\n        CountWing[Count wing-mounted engines&lt;br/&gt;std::count_if &amp; std::visit&lt;br/&gt;Check if Parent::Wing]:::process\n        \n        %% Decision Node\n        DecideSort{n_wing_mounted &gt; 2?}:::decision\n        \n        %% Step 3: Sorting logic (If true)\n        subgraph SortLogic [\&quot;Multi-Engine Sorting Algorithm\&quot;]\n            direction TB\n            PartitionLateral[Loop 1: Partition by Lateral Position&lt;br/&gt;Check Lateral::Left via std::visit&lt;br/&gt;Swap Left engines to front]:::process\n            SortThrust[Loop 2: Sort by Thrust&lt;br/&gt;Extract thrust via std::visit&lt;br/&gt;Swap to order left/right groups by thrust]:::process\n            \n            PartitionLateral --&gt; SortThrust\n        end\n        \n        %% Step 4: Finalize\n        SaveOrder[Save permutation array&lt;br/&gt;this-&gt;swapped_order = v]:::process\n\n        %% Connections\n        InitVector --&gt; CountWing\n        CountWing --&gt; DecideSort\n        \n        DecideSort --&gt;|Yes| PartitionLateral\n        DecideSort --&gt;|No| SaveOrder\n        \n        SortThrust --&gt; SaveOrder\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; InitVector\n    \n    EndNode([End sort_propulsors()&lt;br&gt;Return to initialize() pipeline]):::startEnd\n    \n    SaveOrder --&gt; EndNode\n\n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    InitVector -. \&quot;Uses std::iota\&quot; .-&gt; Ext1\n    CountWing -. \&quot;Uses std::count_if &amp; std::visit\&quot; .-&gt; Ext1\n    PartitionLateral -. \&quot;Uses std::swap &amp; std::visit\&quot; .-&gt; Ext1\n    SortThrust -. \&quot;Uses std::swap &amp; std::visit\&quot; .-&gt; Ext1\n    \n    CountWing -. \&quot;Checks Parent::Wing\&quot; .-&gt; Int1\n    PartitionLateral -. \&quot;Checks Lateral::Left\&quot; .-&gt; Int1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="i8T4ake8SaifuAXGHSQj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
