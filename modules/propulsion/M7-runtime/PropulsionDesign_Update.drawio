  <diagram id="-lAr2AK6xGsnQUuHruit" name="report::generate_data()">
    <mxGraphModel dx="3308" dy="1398" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Dependencies fill:#F0F8FF,stroke:#8BADC1,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n    style ExpUpdate fill:#F5F5F5,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3[(Data / Libraries)]:::io\n        L4{Decision}:::decision\n        L5[Exception / Error]:::error\n    end\n\n    %% ==========================================\n    %% DEPENDENCIES\n    %% ==========================================\n    subgraph Dependencies [\&quot;Explicit File Dependencies\&quot;]\n        direction TB\n        Ext1[(io::load_engine_scaled&lt;br/&gt;External Method outside of Report (src/io/engine_xml.h))]:::io\n        Ext2[(BucketCurve::from_engine_data&lt;br/&gt;Internal Method within Report (src/report/report_data.h))]:::io\n        Ext3[(engine.calculate_N1_with_penalties&lt;br/&gt;External Method outside of Report (src/engine/engine.h))]:::io\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start report::generate_data()&lt;br/&gt;File: src/report/report_data.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Report Data Generation Workflow\&quot;]\n        direction TB\n        \n        InitData[\&quot;Initialize Data struct&lt;br/&gt;Insert empty bucket curves\&quot;]:::process\n        \n        LoopEngines{Iterate over&lt;br/&gt;all propulsions}:::decision\n        \n        CallUpdate[\&quot;Call: update_report_data(...) via std::visit\&quot;]:::process\n        \n        ReturnData[\&quot;Return Data object\&quot;]:::process\n        \n        %% Flow\n        InitData --&gt; LoopEngines\n        LoopEngines --&gt;|Next Engine| CallUpdate\n        CallUpdate --&gt; LoopEngines\n        LoopEngines --&gt;|Done| ReturnData\n    end\n\n    %% ==========================================\n    %% EXPANDED VIEW (Level 3 Subroutine)\n    %% ==========================================\n    subgraph ExpUpdate [\&quot;Expanded View: update_report_data()\&quot;]\n        direction TB\n        \n        LoadEngine[\&quot;Call: io::load_engine_scaled()\&quot;]:::process\n        \n        %% With offtakes\n        TryWith[\&quot;try { Calculate BucketCurve with offtakes }\&quot;]:::process\n        CatchWith[\&quot;catch: Print exception\&quot;]:::error\n        \n        %% Without offtakes\n        TryWithout[\&quot;try { Calculate BucketCurve without offtakes }\&quot;]:::process\n        CatchWithout[\&quot;catch: Print exception\&quot;]:::error\n        \n        %% Takeoff values\n        CalcTakeoff[\&quot;Call: calculate_N1_with_penalties()\&quot;]:::process\n        AccumulateData[\&quot;Accumulate SLST, takeoff thrust,&lt;br/&gt;and takeoff fuel flow into data struct\&quot;]:::process\n        \n        %% Flow\n        LoadEngine --&gt; TryWith\n        TryWith --&gt;|Success| TryWithout\n        TryWith --&gt;|Exception| CatchWith\n        CatchWith --&gt; TryWithout\n        \n        TryWithout --&gt;|Success| CalcTakeoff\n        TryWithout --&gt;|Exception| CatchWithout\n        CatchWithout --&gt; CalcTakeoff\n        \n        CalcTakeoff --&gt; AccumulateData\n    end\n\n    %% Flow linkage\n    CallUpdate -. \&quot;Expands to\&quot; .-&gt; LoadEngine\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; InitData\n    \n    EndNode([End report::generate_data() Complete&lt;br&gt;Return control to PropulsionDesign::update()]):::startEnd\n    ReturnData --&gt; EndNode\n    \n    %% ==========================================\n    %% DEPENDENCY LINKS\n    %% ==========================================\n    LoadEngine -. \&quot;Uses\&quot; .-&gt; Ext1\n    TryWith -. \&quot;Uses\&quot; .-&gt; Ext2\n    TryWithout -. \&quot;Uses\&quot; .-&gt; Ext2\n    CalcTakeoff -. \&quot;Uses\&quot; .-&gt; Ext3\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lpCj_5rFtVf9keqThH12-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
