        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% PASTEL AESTHETIC STYLE PATTERN\n    %% ==========================================\n    classDef startEnd fill:#C8C8FF,stroke:#7A7AD8,stroke-width:2px,color:#333333;\n    classDef process fill:#D0E8F2,stroke:#8BADC1,stroke-width:1px,color:#333333;\n    classDef io fill:#FFE4C4,stroke:#D9B382,stroke-width:1px,color:#333333;\n    classDef decision fill:#FFFACD,stroke:#D4C873,stroke-width:1.5px,color:#333333;\n    classDef error fill:#FFC0CB,stroke:#D1828F,stroke-width:1.5px,color:#333333;\n    classDef subroutine fill:#E6E6FA,stroke:#9370DB,stroke-width:2px,color:#333333,stroke-dasharray: 5 5;\n    classDef legendNode fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#333333;\n\n    %% Subgraph Styling\n    style Pipeline fill:#FCFCFE,stroke:#D0D0E0,stroke-width:2px,stroke-dasharray: 5 5,color:#333333;\n    style Legend fill:#F9F9F9,stroke:#CCCCCC,stroke-width:1px;\n\n    %% ==========================================\n    %% LEGEND\n    %% ==========================================\n    subgraph Legend [\&quot;Diagram Legend\&quot;]\n        direction LR\n        L1([Entry / Exit]):::startEnd\n        L2[Standard Operation]:::process\n        L3{Decision}:::decision\n        L4[[Subroutine]]:::subroutine\n    end\n\n    %% ==========================================\n    %% ENTRY POINT\n    %% ==========================================\n    Entry([Start report::generate_data()&lt;br/&gt;File: src/report/report_data.cpp]):::startEnd\n\n    %% ==========================================\n    %% MAIN PIPELINE (Level 2)\n    %% ==========================================\n    subgraph Pipeline [\&quot;Report Data Generation Workflow\&quot;]\n        direction TB\n        \n        InitData[\&quot;Initialize Data struct&lt;br/&gt;Insert empty bucket curves\&quot;]:::process\n        \n        LoopEngines{Iterate over&lt;br/&gt;all propulsions}:::decision\n        \n        CallUpdate[[Subroutine: update_report_data(...)&lt;br/&gt;Internal Method within Report (src/report/report_data.cpp)]]:::subroutine\n        \n        ReturnData[\&quot;Return Data object\&quot;]:::process\n        \n        %% Flow\n        InitData --&gt; LoopEngines\n        LoopEngines --&gt;|Next Engine| CallUpdate\n        CallUpdate --&gt; LoopEngines\n        LoopEngines --&gt;|Done| ReturnData\n    end\n\n    %% ==========================================\n    %% FLOW CONNECTIONS\n    %% ==========================================\n    Entry --&gt; InitData\n    \n    EndNode([End report::generate_data() Complete&lt;br&gt;Return control to PropulsionDesign::update()]):::startEnd\n    ReturnData --&gt; EndNode&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lgMLJii-QrbgRHlZFRZ6-1">
