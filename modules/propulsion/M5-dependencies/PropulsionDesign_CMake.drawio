  <diagram id="8vPNGvkJdGdq-pOiqCbA" name="PropulsionDesign Libraries Dependency">
    <mxGraphModel dx="3095" dy="1470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% Source Modules on the Left\n    subgraph Src[\&quot;propulsion_design/src/\&quot;]\n        direction TB\n        io_src[\&quot;io/\&quot;]:::internal\n        root_src[\&quot;Root Headers\&quot;]:::internal\n        eng_src[\&quot;engine_design/\&quot;]:::internal\n        report_src[\&quot;report/\&quot;]:::internal\n        integ_src[\&quot;integration/\&quot;]:::internal\n        nacelle_src[\&quot;nacelle/\&quot;]:::internal\n        pylon_src[\&quot;pylon/\&quot;]:::internal\n        mass_src[\&quot;mass/\&quot;]:::internal\n    end\n\n    %% Shared Libraries on the Right\n    subgraph Libs[\&quot;Linked Libraries\&quot;]\n        direction TB\n        aixml[\&quot;UnicadoLibs::aixml\&quot;]:::unicadoLib\n        atmosphere[\&quot;UnicadoLibs::atmosphere\&quot;]:::unicadoLib\n        engine[\&quot;UnicadoLibs::engine\&quot;]:::unicadoLib\n        moduleBasics[\&quot;UnicadoLibs::moduleBasics\&quot;]:::unicadoLib\n        matplot[\&quot;Matplot++::matplot\&quot;]:::externalLib\n        aircraftGeometry2[\&quot;UnicadoLibs::aircraftGeometry2\&quot;]:::unicadoLib\n        eigen[\&quot;Eigen3::Eigen\&quot;]:::externalLib\n    end\n\n    %% Dependency Links based on #include scans\n    io_src --&gt;|#include| aixml\n    io_src --&gt;|#include| aircraftGeometry2\n    io_src --&gt;|#include| engine\n\n    root_src --&gt;|#include| aixml\n    root_src --&gt;|#include| aircraftGeometry2\n    root_src --&gt;|#include| moduleBasics\n    root_src --&gt;|#include| atmosphere\n\n    eng_src --&gt;|#include| engine\n\n    report_src --&gt;|#include| moduleBasics\n    report_src --&gt;|#include| matplot\n    report_src --&gt;|#include| aircraftGeometry2\n    report_src --&gt;|#include| engine\n\n    integ_src --&gt;|#include| aircraftGeometry2\n    nacelle_src --&gt;|#include| aircraftGeometry2\n    pylon_src --&gt;|#include| aircraftGeometry2\n\n    mass_src --&gt;|#include| eigen\n   