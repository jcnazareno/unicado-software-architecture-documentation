        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Root Project Node\n    subgraph Root[\&quot;unicado-package/ (Root Project Directory)\&quot;]\n        UNICADO_Root[\&quot;«Project»&lt;br/&gt;UNICADO\&quot;]:::rootProject\n    end\n\n    %% Subdirectories representing packages\n    subgraph AD_Folder[\&quot;aircraft-design/ (Package Folder)\&quot;]\n        AD_Modules[\&quot;Design Modules&lt;br/&gt;(e.g., propulsion_design)\&quot;]:::folder\n    end\n\n    subgraph Libs_Folder[\&quot;libraries/ (Package Folder)\&quot;]\n        Lib_Targets[\&quot;Shared C++ Libraries&lt;br/&gt;(UnicadoLibs::*)\&quot;]:::unicadoLib\n    end\n\n    subgraph Assess_Folder[\&quot;assessment/ (Package Folder)\&quot;]\n        Assess_Modules[\&quot;Assessment Modules\&quot;]:::folder\n    end\n\n    subgraph Util_Folder[\&quot;utilities/ (Package Folder)\&quot;]\n        Util_Modules[\&quot;Utility Tools\&quot;]:::folder\n    end\n\n    subgraph Install_Folder[\&quot;installer/ (Folder)\&quot;]\n        Installer_Target[\&quot;Package &amp; Installation Rules\&quot;]:::folder\n    end\n\n    %% Configuration Dependency / Sequence Flow\n    UNICADO_Root --&gt;|add_subdirectory| Libs_Folder\n    UNICADO_Root --&gt;|add_subdirectory| AD_Folder\n    UNICADO_Root --&gt;|add_subdirectory| Assess_Folder\n    UNICADO_Root --&gt;|add_subdirectory| Util_Folder\n    UNICADO_Root --&gt;|add_subdirectory| Install_Folder\n\n    %% Logical linking (aircraft-design depends on libraries)\n    AD_Folder -.-&gt;|links| Libs_Folder\n    Assess_Folder -.-&gt;|links| Libs_Folder\n\n    %% Style definitions matching the propulsion_design diagram\n    classDef rootProject fill:#1A365D,stroke:#0A192F,stroke-width:2px,color:#FFFFFF;\n    classDef folder fill:#EDF2F7,stroke:#CBD5E0,stroke-width:1px,color:#2D3748;\n    classDef unicadoLib fill:#3182CE,stroke:#2B6CB0,stroke-width:1px,color:#FFFFFF;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="efL5Q494jM8bUyGz0PLY-2">
