      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% Source Files on the Left\n    subgraph Src_Mass [\&quot;propulsion_design/src/mass/\&quot;]\n        direction TB\n        h_ma[\&quot;mass_analysis.h\&quot;]:::internal\n        h_pm[\&quot;point_mass.h\&quot;]:::internal\n        cpp_pm[\&quot;point_mass.cpp\&quot;]:::internal\n\n        subgraph Default_Folder [\&quot;default/\&quot;]\n            direction TB\n            h_dm[\&quot;default_mass.h\&quot;]:::internal\n            cpp_tf[\&quot;turbofan.cpp\&quot;]:::internal\n            cpp_or[\&quot;openrotorfan.cpp\&quot;]:::internal\n        end\n    end\n\n    %% External/Shared Libraries on the Right\n    subgraph Libs [\&quot;External Libraries\&quot;]\n        direction TB\n        \n        subgraph Eigen_Lib [\&quot;Eigen3::Eigen\&quot;]\n            direction TB\n            eigen_vec[\&quot;Eigen::Vector3d&lt;br/&gt;(Stores CG coordinates)\&quot;]:::dataNode\n            eigen_mat[\&quot;Eigen::Matrix3d&lt;br/&gt;(Stores Inertia tensors)\&quot;]:::dataNode\n        end\n        \n        subgraph Geom_Lib [\&quot;UnicadoLibs::aircraftGeometry2\&quot;]\n            direction TB\n            geom_cent[\&quot;geom2::measure::centroid()&lt;br/&gt;(Calculates geometric CG)\&quot;]:::funcNode\n            geom_trans[\&quot;geom2::transform::to_parent()&lt;br/&gt;(Transforms KOS)\&quot;]:::funcNode\n            geom_inert[\&quot;geom2::measure::inertia()&lt;br/&gt;(Calculates tensor)\&quot;]:::funcNode\n        end\n    end\n\n    %% Connections flowing strictly from Source Files to Libraries\n    h_pm --&gt;|declares| eigen_vec\n    h_pm --&gt;|declares| eigen_mat\n\n    cpp_pm --&gt;|calculates| eigen_vec\n    cpp_pm --&gt;|calculates| eigen_mat\n\n    cpp_tf --&gt;|extracts| geom_cent\n    cpp_tf --&gt;|extracts| geom_trans\n    cpp_tf --&gt;|extracts| geom_inert\n    cpp_tf --&gt;|populates| eigen_vec\n    cpp_tf --&gt;|populates| eigen_mat\n\n    cpp_or --&gt;|extracts| geom_cent\n    cpp_or --&gt;|extracts| geom_trans\n    cpp_or --&gt;|extracts| geom_inert\n    cpp_or --&gt;|populates| eigen_vec\n    cpp_or --&gt;|populates| eigen_mat\n\n    %% Styles\n    classDef internal fill:#EDF2F7,stroke:#CBD5E0,stroke-width:1px,color:#2D3748;\n    classDef dataNode fill:#EBF8FF,stroke:#3182CE,stroke-width:1px,color:#2B6CB0;\n    classDef funcNode fill:#F0FFF4,stroke:#38A169,stroke-width:1px,color:#2F855A;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="91-F2ArTEbeTRJf50-ay-1">
